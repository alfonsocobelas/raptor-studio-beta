// Configuración de Grafana Alloy: raspa el /metrics del backend (protegido por token) y lo
// empuja a Grafana Cloud. Los valores vienen del .env del compose; aquí no hay secretos.

prometheus.scrape "app" {
  targets = [{
    __address__      = "backend:3000",
    __metrics_path__ = "/metrics",
  }]
  scrape_interval = "30s"

  authorization {
    type        = "Bearer"
    credentials = sys.env("METRICS_TOKEN")
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_PROM_TOKEN")
    }
  }
}
