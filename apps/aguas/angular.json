{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "frontend-app": {
      "projectType": "application",
      "root": "apps/frontend-app",
      "sourceRoot": "apps/frontend-app/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/frontend-app",
            "browser": "apps/frontend-app/src/main.ts",
            "index": "apps/frontend-app/src/index.html",
            "tsConfig": "apps/frontend-app/tsconfig.app.json",
            "styles": ["apps/frontend-app/src/styles.css"],
            "polyfills": []
          },
          "configurations": {
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "frontend-app:build", "port": 4200 }
        }
      }
    }
  }
}
