{
  "name": "app",
  "private": true,
  "scripts": {
    "start": "ts-node -T -r tsconfig-paths/register apps/backend-api/src/main.ts",
    "seed": "ts-node -T -r tsconfig-paths/register libs/backend/src/seed.ts",
    "web": "ng serve --proxy-config apps/frontend-app/proxy.conf.json",
    "web:build": "ng build",
    "typecheck": "tsc -p tsconfig.json",
    "ui:add": "nx g @spartan-ng/cli:ui",
    "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create libs/backend/src/contexts/shared/infrastructure/persistence/typeorm/migrations/Migration",
    "migration:generate": "NODE_ENV=local ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d libs/backend/src/contexts/shared/infrastructure/persistence/typeorm/typeorm-data-source.ts libs/backend/src/contexts/shared/infrastructure/persistence/typeorm/migrations/Migration",
    "migration:run": "NODE_ENV=local ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d libs/backend/src/contexts/shared/infrastructure/persistence/typeorm/typeorm-data-source.ts",
    "migration:revert": "NODE_ENV=local ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d libs/backend/src/contexts/shared/infrastructure/persistence/typeorm/typeorm-data-source.ts"
  },
  "dependencies": {
    "@angular/cdk": "21.2.6",
    "@angular/common": "21.2.8",
    "@angular/compiler": "21.2.8",
    "@angular/core": "21.2.8",
    "@angular/forms": "21.2.8",
    "@angular/material": "21.2.6",
    "@angular/platform-browser": "21.2.8",
    "@angular/router": "21.2.8",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "@ng-icons/core": "^33.2.0",
    "@ng-icons/lucide": "^33.2.0",
    "@spartan-ng/brain": "^1.3.0",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^0.3.30",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.8",
    "@angular/cli": "21.2.8",
    "@angular/compiler-cli": "21.2.8",
    "@nx/angular": "^22.7.5",
    "@nx/devkit": "^22.7.5",
    "@nx/js": "^22.7.5",
    "@nx/workspace": "^22.7.5",
    "@spartan-ng/cli": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "nx": "^22.7.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.8"
  }
}
