{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "importHelpers": false,
    "paths": {
      "@raptor/generators": ["./libs/generators/src/index.ts"],
      "@raptor/schema": ["./libs/schema/src/index.ts"],
      "@raptor/infra-ports": ["./libs/infra/ports/src/index.ts"],
      "@raptor/infra-storage-azure": ["./libs/infra/storage-azure/src/index.ts"],
      "@raptor/infra-observability-azure": ["./libs/infra/observability-azure/src/index.ts"],
      "@raptor/infra-config-azure": ["./libs/infra/config-azure/src/index.ts"],
      "@raptor/infra-auth": ["./libs/infra/auth/src/index.ts"],
      "@raptor/infra-session-redis": ["./libs/infra/session-redis/src/index.ts"],
      "@raptor/infra-storage-s3": ["./libs/infra/storage-s3/src/index.ts"],
      "@raptor/infra-secrets": ["./libs/infra/secrets/src/index.ts"],
      "@raptor/infra-metrics-prometheus": ["./libs/infra/metrics-prometheus/src/index.ts"],
      "@raptor/infra-storage-gcs": ["./libs/infra/storage-gcs/src/index.ts"],
      "@raptor/infra-observability-sentry": ["./libs/infra/observability-sentry/src/index.ts"],
      "@raptor/infra-config-aws": ["./libs/infra/config-aws/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "docs/referencia"]
}
