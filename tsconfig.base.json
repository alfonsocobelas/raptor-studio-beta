{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "importHelpers": false,
    "paths": {
      "@acc/generators": ["./libs/generators/src/index.ts"],
      "@acc/schema": ["./libs/schema/src/index.ts"],
      "@acc/infra/ports": ["./libs/infra/ports/src/index.ts"],
      "@acc/infra/storage-azure": ["./libs/infra/storage-azure/src/index.ts"],
      "@acc/infra/observability-azure": ["./libs/infra/observability-azure/src/index.ts"],
      "@acc/infra/config-azure": ["./libs/infra/config-azure/src/index.ts"],
      "@acc/infra/auth": ["./libs/infra/auth/src/index.ts"],
      "@acc/infra/session-redis": ["./libs/infra/session-redis/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "docs/referencia"]
}
