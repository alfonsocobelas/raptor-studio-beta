<%_
const nest = ['Controller', 'Get', 'Param', 'Query', 'StreamableFile']
if (app.writes) nest.push('Body', 'Post', 'Put', 'HttpCode', 'HttpStatus')
if (app.removes) nest.push('Delete', 'HttpCode', 'HttpStatus')
const nestList = [...new Set(nest)].sort()
_%>
import { <%- nestList.join(', ') %> } from '@nestjs/common'
import { UserRoleEnum } from '<%- sharedDomainAlias %>'
import { OffsetPaginatedOutput } from '../../../../../shared/application/dtos/search-output.dto'
import { buildExportFile } from '../../../../../shared/infrastructure/export/build-export-file'
import { PaginateOffsetDto } from '../../../../../shared/infrastructure/dtos/paginate-offset.dto'
import { ParseCriteriaPipe } from '../../../../../shared/infrastructure/pipes/parse-criteria.pipe'
import { ParseUUIDv7Pipe } from '../../../../../shared/infrastructure/pipes/parse-uuid-v7.pipe'
import { Roles } from '../../../../../shared/infrastructure/auth/roles.decorator'
<%_ if (app.history) { _%>
import { AuditEvent } from '../../../../../shared/domain/audit/audit-event'
<%_ } _%>
import { Export<%- pluralClassName %>Handler } from '../../application/handlers/export-<%- plural %>.handler'
import { Get<%- className %>Handler } from '../../application/handlers/get-<%- fileName %>.handler'
<%_ if (app.history) { _%>
import { Get<%- className %>HistoryHandler } from '../../application/handlers/get-<%- fileName %>-history.handler'
<%_ } _%>
<%_ if (app.writes) { _%>
import { Register<%- className %>Handler } from '../../application/handlers/register-<%- fileName %>.handler'
<%_ } _%>
<%_ if (app.removes) { _%>
import { Remove<%- className %>Handler } from '../../application/handlers/remove-<%- fileName %>.handler'
<%_ } _%>
import { Aggregate<%- pluralClassName %>Handler } from '../../application/handlers/aggregate-<%- plural %>.handler'
import { Search<%- pluralClassName %>Handler } from '../../application/handlers/search-<%- plural %>.handler'
<%_ entry.transitions.forEach(transition => { _%>
import { <%- transition.className %>Handler } from '../../application/handlers/<%- transition.file %>.handler'
<%_ }) _%>
<%_ if (app.writes) { _%>
import { Update<%- className %>Handler } from '../../application/handlers/update-<%- fileName %>.handler'
<%_ } _%>
<%_ if (aggregate.composition) { _%>
import { <%- className %>DetailOutput } from '../../application/use-cases/get-<%- fileName %>-usecase.service'
import { <%- className %>PrimitiveProps<% if (app.writes) { %>, <%- className %>UpdateProps<% } %> } from '../../domain/<%- fileName %>-types'
<%_ } else { _%>
import { <%- className %>PrimitiveProps<% if (app.writes) { %>, <%- className %>UpdateProps<% } %> } from '../../domain/<%- fileName %>-types'
<%_ } _%>
import { AggregateOutput } from '../../../../../shared/domain/query/aggregate'
import { Aggregate<%- pluralClassName %>QueryDto } from './dtos/aggregate-<%- plural %>-query.dto'
import { Export<%- pluralClassName %>QueryDto } from './dtos/export-<%- plural %>-query.dto'
import { <%- constantName %>_EXPORT_COLUMNS } from './<%- plural %>-export-columns'
<%_ if (app.writes) { _%>
import { Register<%- className %>Dto } from './dtos/register-<%- fileName %>.dto'
import { Update<%- className %>Dto } from './dtos/update-<%- fileName %>.dto'
<%_ } _%>

@Controller('<%- plural %>')
export class <%- pluralClassName %>Controller {
  constructor(
<%_ if (app.writes) { _%>
    private readonly register<%- className %>Handler: Register<%- className %>Handler,
<%_ } _%>
    private readonly search<%- pluralClassName %>Handler: Search<%- pluralClassName %>Handler,
    private readonly aggregate<%- pluralClassName %>Handler: Aggregate<%- pluralClassName %>Handler,
    private readonly get<%- className %>Handler: Get<%- className %>Handler,
<%_ if (app.history) { _%>
    private readonly get<%- className %>HistoryHandler: Get<%- className %>HistoryHandler,
<%_ } _%>
<%_ if (app.writes) { _%>
    private readonly update<%- className %>Handler: Update<%- className %>Handler,
<%_ } _%>
<%_ entry.transitions.forEach(transition => { _%>
    private readonly <%- transition.method %><%- className %>Handler: <%- transition.className %>Handler,
<%_ }) _%>
<%_ if (app.removes) { _%>
    private readonly remove<%- className %>Handler: Remove<%- className %>Handler,
<%_ } _%>
    private readonly export<%- pluralClassName %>Handler: Export<%- pluralClassName %>Handler
  ) {}
<%_ if (app.writes) { _%>

  @Post()
  @Roles(<%- entry.createRoles %>)
  register(@Body() body: Register<%- className %>Dto): Promise<void> {
    return this.register<%- className %>Handler.handle(body)
  }
<%_ } _%>

  @Get()
  @Roles(<%- entry.readRoles %>)
  search(
    @Query(new ParseCriteriaPipe()) query: PaginateOffsetDto
  ): Promise<OffsetPaginatedOutput<<%- className %>PrimitiveProps>> {
    return this.search<%- pluralClassName %>Handler.handle(query)
  }

  // Una agregación del conjunto filtrado (spec 71). Declarado antes de `:id`, o 'aggregate' se
  // leería como un uuid. Mismos roles que el listado: agregar es leer, no una capacidad nueva.
  @Get('aggregate')
  @Roles(<%- entry.readRoles %>)
  aggregate(@Query(new ParseCriteriaPipe()) query: Aggregate<%- pluralClassName %>QueryDto): Promise<AggregateOutput> {
    return this.aggregate<%- pluralClassName %>Handler.handle(query)
  }

  // Exports the full filtered <%- fileName %> set (no pagination) as CSV/XLSX. Declared before `:id`.
  @Get('export')
  @Roles(<%- entry.readRoles %>)
  async export(@Query(new ParseCriteriaPipe()) query: Export<%- pluralClassName %>QueryDto): Promise<StreamableFile> {
    const rows = await this.export<%- pluralClassName %>Handler.handle(query)
    return buildExportFile(rows, <%- constantName %>_EXPORT_COLUMNS, query.format, '<%- entry.exportFileName %>')
  }

<%_ if (app.history) { _%>
  // La timeline de la ficha (spec 31): los últimos eventos del registro.
  @Get(':id/history')
  @Roles(<%- entry.readRoles %>)
  history(@Param('id', ParseUUIDv7Pipe) id: string): Promise<AuditEvent[]> {
    return this.get<%- className %>HistoryHandler.handle({ id })
  }

<%_ } _%>
  @Get(':id')
  @Roles(<%- entry.readRoles %>)
  getById(@Param('id', ParseUUIDv7Pipe) id: string): Promise<<%- className %><%- aggregate.composition ? 'DetailOutput' : 'PrimitiveProps' %>> {
    return this.get<%- className %>Handler.handle({ id })
  }
<%_ if (app.writes) { _%>

  @Put(':id')
  @Roles(<%- entry.updateRoles %>)
  @HttpCode(HttpStatus.NO_CONTENT)
  update(@Param('id', ParseUUIDv7Pipe) id: string, @Body() body: Update<%- className %>Dto): Promise<void> {
    const { version, ...updates } = body
    return this.update<%- className %>Handler.handle({ id, version, updates: updates as <%- className %>UpdateProps })
  }
<%_ } _%>
<%_ if (app.removes) { _%>

  @Delete(':id')
  @Roles(<%- entry.deleteRoles %>)
  @HttpCode(HttpStatus.NO_CONTENT)
  remove(@Param('id', ParseUUIDv7Pipe) id: string): Promise<void> {
    return this.remove<%- className %>Handler.handle({ id })
  }
<%_ } _%>
<%_ entry.transitions.forEach(transition => { _%>

  /** Transición «<%- transition.label %>» de la máquina de estados (spec 43): 409 si el estado la rechaza. */
  @Post(':id/<%- transition.verb %>')
  @Roles(<%- transition.roles %>)
  @HttpCode(HttpStatus.NO_CONTENT)
  <%- transition.method %>(@Param('id', ParseUUIDv7Pipe) id: string): Promise<void> {
    return this.<%- transition.method %><%- className %>Handler.handle({ id })
  }
<%_ }) _%>
}
