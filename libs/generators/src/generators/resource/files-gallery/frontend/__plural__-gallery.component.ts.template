import { ChangeDetectionStrategy, Component, computed, inject, linkedSignal } from '@angular/core'
<%_ if (detail) { _%>
import { Router } from '@angular/router'
<%_ } _%>
import { DecimalPipe } from '@angular/common'
import { FormsModule } from '@angular/forms'
import { <%- dtoName %> } from '<%- sharedDomainAlias %>'
import { <%- className %>Service, OffsetPaginatedOutput } from '../../../../../../core/services/<%- fileName %>.service'

/**
 * Galería de <%- ui.title %>: la MISMA lectura del listado pintada como tarjetas.
 * Comparte servicio, búsqueda y paginación — no hay endpoint ni estado propios.
 */
@Component({
  selector: 'app-<%- plural %>-gallery',
  imports: [FormsModule, DecimalPipe],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="min-w-0 space-y-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight"><%- ui.title %></h1>
        <p class="text-muted-foreground"><%- ui.subtitle %></p>
      </div>

      <input
        class="border-input w-full max-w-sm rounded-md border px-3 py-2 text-sm"
        type="search"
        placeholder="Buscar…"
        [ngModel]="search()"
        (ngModelChange)="onSearch($event)"
        aria-label="Buscar"
      />

      @if (isLoading() && !hasData()) {
        <p class="text-muted-foreground py-12 text-center text-sm"><%- ui.loading %></p>
      } @else if (error()) {
        <p class="text-destructive py-12 text-center text-sm"><%- ui.error %></p>
      } @else if (!items().length) {
        <p class="text-muted-foreground py-12 text-center text-sm"><%- ui.empty %></p>
      } @else {
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          @for (item of items(); track item.id) {
            <article
              class="bg-card flex flex-col gap-2 rounded-lg border p-4 transition-shadow hover:shadow-md"
<%_ if (detail) { _%>
              role="button"
              tabindex="0"
              (click)="open(item)"
              (keydown.enter)="open(item)"
<%_ } _%>
            >
              <h2 class="truncate text-base font-semibold">{{ text(item, cardTitle) }}</h2>
<%_ if (gallery.subtitleField) { _%>
              <p class="text-muted-foreground truncate text-sm">{{ text(item, cardSubtitle) }}</p>
<%_ } _%>
<%_ if (gallery.chips.length) { _%>
              <div class="flex flex-wrap gap-1">
                @for (chip of chips; track chip.key) {
                  <span class="bg-muted rounded-full px-2 py-0.5 text-xs">
                    <span class="text-muted-foreground">{{ chip.label }}:</span> {{ text(item, chip.key) }}
                  </span>
                }
              </div>
<%_ } _%>
<%_ if (gallery.metricField) { _%>
              <p class="mt-auto pt-2 text-xl font-bold">
                {{ number(item, cardMetric) | number: '1.0-2' }}
                <span class="text-muted-foreground text-xs font-normal"><%- gallery.metricLabel %></span>
              </p>
<%_ } _%>
            </article>
          }
        </div>

        <div class="flex items-center justify-between text-sm">
          <span class="text-muted-foreground">{{ total() }} en total</span>
          <div class="flex gap-2">
            <button
              type="button"
              class="border-input rounded-md border px-3 py-1 disabled:opacity-50"
              [disabled]="currentPage() === 1"
              (click)="onPage(currentPage() - 1)"
            >
              Anterior
            </button>
            <button
              type="button"
              class="border-input rounded-md border px-3 py-1 disabled:opacity-50"
              [disabled]="currentPage() * pageSize() >= total()"
              (click)="onPage(currentPage() + 1)"
            >
              Siguiente
            </button>
          </div>
        </div>
      }
    </div>
  `
})
export class <%- pluralClassName %>GalleryComponent {
  private readonly _service = inject(<%- className %>Service)
<%_ if (detail) { _%>
  private readonly _router = inject(Router)
<%_ } _%>

  /** Campos que pinta la tarjeta: los decide el generador desde el modelo. */
  readonly cardTitle = '<%- gallery.titleField %>'
<%_ if (gallery.subtitleField) { _%>
  readonly cardSubtitle = '<%- gallery.subtitleField %>'
<%_ } _%>
<%_ if (gallery.metricField) { _%>
  readonly cardMetric = '<%- gallery.metricField %>'
<%_ } _%>
  readonly chips: { key: string; label: string }[] = [
<%_ gallery.chips.forEach(chip => { _%>
    { key: '<%- chip.key %>', label: '<%- chip.label %>' },
<%_ }) _%>
  ]

  readonly isLoading = this._service.<%- plural %>.isLoading
  readonly error = this._service.<%- plural %>.error

  // Igual que el listado: al recargar, resource() vacía value(); conservar la última
  // página evita que la rejilla parpadee en cada búsqueda.
  private readonly _loaded = linkedSignal<
    OffsetPaginatedOutput<<%- dtoName %>> | undefined,
    OffsetPaginatedOutput<<%- dtoName %>> | undefined
  >({
    source: () => this._service.<%- plural %>.value(),
    computation: (value, previous) => value ?? previous?.value
  })

  readonly items = computed(() => this._loaded()?.items ?? [])
  readonly total = computed(() => this._loaded()?.total ?? 0)
  readonly hasData = computed(() => this._loaded() !== undefined)
  readonly currentPage = computed(() => this._service.request().page)
  readonly pageSize = computed(() => this._service.request().pageSize)
  readonly search = computed(() => this._service.request().search ?? '')

  text(item: <%- dtoName %>, key: string): string {
    const value = (item as unknown as Record<string, unknown>)[key]
    if (value === null || value === undefined || value === '') return '—'
    if (typeof value === 'boolean') return value ? 'Sí' : 'No'
    return String(value)
  }

  number(item: <%- dtoName %>, key: string): number {
    return Number((item as unknown as Record<string, unknown>)[key] ?? 0)
  }

  onSearch(search: string): void {
    this._service.request.update(r => ({ ...r, search: search || undefined, page: 1 }))
  }

  onPage(page: number): void {
    this._service.request.update(r => ({ ...r, page }))
  }
<%_ if (detail) { _%>

  open(item: <%- dtoName %>): void {
    void this._router.navigate(['<%- route %>', item.id])
  }
<%_ } _%>

  // @ai:begin gallery-extra — filtros o adornos propios de esta galería
  // @ai:end
}
