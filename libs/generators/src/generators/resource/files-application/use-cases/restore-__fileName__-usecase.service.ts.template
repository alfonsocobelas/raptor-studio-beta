import { Injectable } from '@nestjs/common'
<%_ if (app.history) { _%>
import { AuditTrailPort } from '../../../../../shared/domain/audit/audit-trail.port'
<%_ } _%>
import { EntityNotFoundError } from '../../../../../shared/domain/errors'
<%_ if (dragPlan.length) { _%>
import { TransactionManager } from '../../../../../shared/domain/persistence/transaction-manager'
<%_ } _%>
import { <%- className %>Id } from '../../../../../shared/domain/value-objects/<%- plural %>/<%- fileName %>-id.vo'
import { <%- className %>Repository } from '../../domain/<%- fileName %>-repository'
<%_ dragPlan.forEach(level => { _%>
<%- level.repoImport %>
<%_ }) _%>
import { Restore<%- className %>Input } from '../dtos/restore-<%- fileName %>-input.dto'

@Injectable()
export class Restore<%- className %>UseCase {
<%_ if (dragPlan.length) { _%>
  constructor(
    private readonly <%- propertyName %>Repository: <%- className %>Repository,
<%_ dragPlan.forEach(level => { _%>
    private readonly <%- level.repoProp %>: <%- level.repoClass %>,
<%_ }) _%>
    private readonly txManager: TransactionManager<%- app.history ? ',' : '' %>
<%_ if (app.history) { _%>
    private readonly auditTrail: AuditTrailPort
<%_ } _%>
  ) {}
<%_ } else if (app.history) { _%>
  constructor(
    private readonly <%- propertyName %>Repository: <%- className %>Repository,
    private readonly auditTrail: AuditTrailPort
  ) {}
<%_ } else { _%>
  constructor(private readonly <%- propertyName %>Repository: <%- className %>Repository) {}
<%_ } _%>

  async invoke(input: Restore<%- className %>Input): Promise<void> {
<%_ if (dragPlan.length) { _%>
    const <%- propertyName %>Id = <%- className %>Id.create(input.id)
    // Se revierte LA OPERACIÓN, no la fila: vuelve exactamente lo que aquel borrado
    // arrastró (decisión 1, spec 38). Lo borrado aparte lleva otra operación y se queda.
    const op = await this.<%- propertyName %>Repository.deletedOpOf(<%- propertyName %>Id)

    if (!op) {
      throw new EntityNotFoundError('<%- className %>', input.id)
    }

    await this.txManager.runInTransaction(async () => {
      await this.<%- propertyName %>Repository.restoreByOp(op)
<%_ dragPlan.forEach(level => { _%>
      await this.<%- level.repoProp %>.restoreByOp(op)
<%_ }) _%>
<%_ if (app.history) { _%>
      await this.auditTrail.record({
        entity: '<%- fileName %>',
        entityId: input.id,
        action: 'restored',
        changes: {},
        actor: null
      })
<%_ } _%>
    })
<%_ } else { _%>
    const restored = await this.<%- propertyName %>Repository.restore(<%- className %>Id.create(input.id))

    if (!restored) {
      throw new EntityNotFoundError('<%- className %>', input.id)
    }
<%_ if (app.history) { _%>
    await this.auditTrail.record({
      entity: '<%- fileName %>',
      entityId: input.id,
      action: 'restored',
      changes: {},
      actor: null
    })
<%_ } _%>
<%_ } _%>
  }
}
