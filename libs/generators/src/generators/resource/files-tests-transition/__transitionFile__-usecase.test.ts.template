import { v7 as uuidv7 } from 'uuid'
import { <%- transition.className %>UseCase } from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/use-cases/<%- transition.file %>-usecase.service'
import { ConcurrencyConflictError, EntityNotFoundError } from '../../../../../src/contexts/shared/domain/errors'
import { <%- className %>Mother } from '../../domain/mothers/<%- fileName %>.mother'
import { <%- className %>RepositoryMock } from '../../mocks/<%- fileName %>.repository.mock'

/** Transición «<%- transition.label %>»: <%- transition.from.join(' | ') %> → <%- transition.to %>. */
describe('<%- transition.className %>UseCase', () => {
  let repositoryMock: <%- className %>RepositoryMock
  let useCase: <%- transition.className %>UseCase

  beforeEach(() => {
    repositoryMock = new <%- className %>RepositoryMock()
    useCase = new <%- transition.className %>UseCase(repositoryMock)
  })

  describe('given the <%- propertyName %> does not exist', () => {
    it('throws EntityNotFoundError and does not save', async () => {
      repositoryMock.givenNotFound()

      await expect(useCase.invoke({ id: uuidv7(), version: 1 })).rejects.toThrow(EntityNotFoundError)
      repositoryMock.assertNotCalled('save')
    })
  })

  describe('given a stale version (bloqueo optimista, spec 78)', () => {
    it('throws ConcurrencyConflictError and does not mutate nor save', async () => {
      const current = <%- className %>Mother.reconstruct({ <%- transition.stateField %>: '<%- transition.from[0] %>' })
      repositoryMock.givenFound(current)
      const before = current.toPrimitives()

      await expect(useCase.invoke({ id: current.id.value, version: 99 })).rejects.toThrow(ConcurrencyConflictError)

      repositoryMock.assertNotCalled('save')
      expect(current.toPrimitives()).toEqual(before)
    })
  })

  describe('given a legal source state', () => {
    it('moves the <%- propertyName %> to <%- transition.to %> and saves it once', async () => {
      const current = <%- className %>Mother.reconstruct({ <%- transition.stateField %>: '<%- transition.from[0] %>' })
      repositoryMock.givenFound(current)
      repositoryMock.whenSaveSuccess()

      await useCase.invoke({ id: current.id.value, version: current.version })

      expect(current.toPrimitives().<%- transition.stateField %>).toBe('<%- transition.to %>')
      repositoryMock.assertCalledTimes('save', 1)
    })
  })
<%_ if (transition.illegalFrom) { _%>

  describe('given an illegal source state', () => {
    it('rejects the transition from <%- transition.illegalFrom %> and does not save', async () => {
      const current = <%- className %>Mother.reconstruct({ <%- transition.stateField %>: '<%- transition.illegalFrom %>' })
      repositoryMock.givenFound(current)

      await expect(useCase.invoke({ id: current.id.value, version: current.version })).rejects.toThrow()

      expect(current.toPrimitives().<%- transition.stateField %>).toBe('<%- transition.illegalFrom %>')
      repositoryMock.assertNotCalled('save')
    })
  })
<%_ } _%>
})
