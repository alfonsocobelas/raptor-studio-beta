import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core'
import { ActivatedRoute, Router } from '@angular/router'
import { provideIcons } from '@ng-icons/core'
import { NgIcon } from '@ng-icons/core'
import { lucideArrowLeft<%- features.edit ? ', lucidePencil' : '' %><%- features.delete ? ', lucideTrash2' : '' %> } from '@ng-icons/lucide'
<%_ if (features.edit || features.delete) { _%>
import { NotificationService } from '../../../../../../shared/components/ui/notification.service'
import { AuthService } from '../../../../../../core/services/auth.service'
<%_ } _%>
<%_ if (features.delete) { _%>
import { AppConfirmDialog } from '../../../../../../shared/components/ui/confirm-dialog'
<%_ } _%>
<%_ if (features.edit) { _%>
import { AppDialog } from '../../../../../../shared/components/ui/dialog'
import { <%- className %>DialogComponent, <%- className %>FormValue } from './<%- fileName %>-dialog.component'
<%_ } _%>
import { <%- features.history ? `AuditEventDto, ${dtoName}` : dtoName %> } from '<%- sharedDomainAlias %>'
import { <%- className %>Service } from '../../../../../../core/services/<%- fileName %>.service'
import { formatValue } from '../../../../../../shared/utils/format-value'
<%_ if (related.length) { _%>
import { RelatedTable } from '../../../../../../shared/components/related-table'
<%_ } _%>
<%_ if (attachments) { _%>
import { <%- className %>AttachmentsComponent } from './<%- fileName %>-attachments.component'
<%_ } _%>

/** Una fila de la ficha: qué campo, cómo se llama y cómo se formatea. */
interface DetailRow {
  key: string
  label: string
  type?: 'date' | 'number' | 'boolean'
  /** Etiquetas de un conjunto cerrado: el valor guardado se lee como en el listado */
  labels?: Record<string, string>
}

/**
 * Ficha de <%- ui.title %>: el destino de la acción «ver» del listado. Carga el
 * registro por el id de la ruta y muestra sus campos; las escrituras reutilizan
 * el mismo diálogo y la misma confirmación que el listado.
 */
@Component({
  selector: 'app-<%- fileName %>-detail',
  imports: [NgIcon<%- related.length ? ', RelatedTable' : '' %><%- features.edit ? ', AppDialog, ' + className + 'DialogComponent' : '' %><%- features.delete ? ', AppConfirmDialog' : '' %><%- attachments ? ', ' + className + 'AttachmentsComponent' : '' %>],
  providers: [provideIcons({ lucideArrowLeft<%- features.edit ? ', lucidePencil' : '' %><%- features.delete ? ', lucideTrash2' : '' %> })],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="min-w-0 space-y-6">
      <button type="button" class="text-muted-foreground flex items-center gap-2 text-sm" (click)="back()">
        <ng-icon name="lucideArrowLeft" size="16" />
        Volver a <%- labelPlural %>
      </button>

      @if (loading()) {
        <p class="text-muted-foreground py-12 text-center text-sm"><%- ui.loading %></p>
      } @else if (notFound()) {
        <p class="text-muted-foreground py-12 text-center text-sm">No se encontró el registro solicitado.</p>
      } @else if (error()) {
        <p class="text-destructive py-12 text-center text-sm"><%- ui.error %></p>
      } @else if (<%- propertyName %>(); as item) {
        <div class="flex items-start justify-between gap-4">
          <h1 class="text-2xl font-bold tracking-tight">{{ item.<%- detail.titleField %> }}</h1>
          <div class="flex gap-2">
<%_ entry.transitions.forEach(transition => { _%>
            @if (canWrite() && <%- transition.fromCheck %>) {
              <button
                type="button"
                class="border-input hover:bg-accent flex items-center gap-2 rounded-md border px-3 py-2 text-sm disabled:opacity-50"
                [disabled]="transitioning()"
                data-testid="transition-<%- transition.verb %>"
                (click)="<%- transition.method %>(item.id)"
              >
                <%- transition.label %>
              </button>
            }
<%_ }) _%>
<%_ if (features.edit) { _%>
            @if (canWrite()) {
              <button
                type="button"
                class="border-input hover:bg-accent flex items-center gap-2 rounded-md border px-3 py-2 text-sm"
                (click)="openEdit(item)"
              >
                <ng-icon name="lucidePencil" size="16" />
                Editar
              </button>
            }
<%_ } _%>
<%_ if (features.delete) { _%>
            @if (canWrite()) {
              <button
                type="button"
                class="text-destructive hover:bg-accent flex items-center gap-2 rounded-md px-3 py-2 text-sm"
                (click)="deleteDialogOpen.set(true)"
              >
                <ng-icon name="lucideTrash2" size="16" />
                Eliminar
              </button>
            }
<%_ } _%>
          </div>
        </div>

        <dl class="bg-card grid grid-cols-1 gap-x-8 gap-y-4 rounded-lg border p-6 sm:grid-cols-2">
          @for (row of rows; track row.key) {
            <div class="min-w-0">
              <dt class="text-muted-foreground text-xs uppercase tracking-wide">{{ row.label }}</dt>
              <dd class="truncate text-sm font-medium">{{ format(item, row) }}</dd>
            </div>
          }
        </dl>
<%_ related.forEach(rel => { _%>

        <app-related-table
          title="<%- rel.title %>"
          endpoint="<%- rel.endpoint %>"
          field="<%- rel.field %>"
          [value]="item.id"
          [columns]="<%- rel.columns %>"
          route="<%- rel.route %>"
        />
<%_ }) _%>
<%_ if (attachments) { _%>

        <app-<%- plural %>-attachments [<%- propertyName %>Id]="item.id" />
<%_ } _%>
<%_ if (features.history) { _%>

        <!-- la timeline del registro (spec 31): qué pasó, qué cambió y cuándo -->
        <section class="bg-card rounded-lg border p-4">
          <h2 class="mb-3 text-sm font-semibold">Historial</h2>
          @if (!history().length) {
            <p class="text-muted-foreground text-sm">Sin cambios registrados</p>
          } @else {
            <ol class="space-y-3">
              @for (event of history(); track event.id) {
                <li class="border-border border-l-2 pl-3" data-testid="history-event">
                  <div class="flex items-baseline gap-2">
                    <span class="text-sm font-medium">{{ actionLabel(event) }}</span>
                    <span class="text-muted-foreground text-xs">{{ when(event) }}</span>
                  </div>
                  @if (changedFields(event).length) {
                    <div class="mt-1 flex flex-wrap gap-1">
                      @for (change of changedFields(event); track change.field) {
                        <span class="bg-muted rounded-full px-2 py-0.5 text-xs">
                          <span class="text-muted-foreground">{{ change.field }}:</span>
                          {{ change.from }} → {{ change.to }}
                        </span>
                      }
                    </div>
                  }
                </li>
              }
            </ol>
          }
        </section>
<%_ } _%>
      }
    </div>
<%_ if (features.edit) { _%>

    <app-dialog [open]="dialogOpen()" (closed)="dialogOpen.set(false)">
      @if (dialogOpen()) {
        <app-<%- fileName %>-dialog
          [<%- propertyName %>]="<%- propertyName %>()"
          (saved)="onSave($event)"
          (close)="dialogOpen.set(false)"
        />
      }
    </app-dialog>
<%_ } _%>
<%_ if (features.delete) { _%>

    <app-confirm-dialog
      [open]="deleteDialogOpen()"
      title="<%- ui.deleteTitle %>"
      [description]="deleteDescription()"
      (confirmed)="onDelete()"
      (closed)="deleteDialogOpen.set(false)"
    />
<%_ } _%>
  `
})
export class <%- className %>DetailComponent {
  private readonly _route = inject(ActivatedRoute)
  private readonly _router = inject(Router)
  private readonly _service = inject(<%- className %>Service)
<%_ if (features.edit || features.delete || entry.transitions.length) { _%>
  private readonly _auth = inject(AuthService)
  private readonly _notify = inject(NotificationService)

  protected readonly canWrite = computed(() => this._auth.canWrite())
<%_ } _%>

  readonly <%- propertyName %> = signal<<%- dtoName %> | null>(null)
  readonly loading = signal(true)
  readonly notFound = signal(false)
  readonly error = signal(false)
<%_ if (features.edit) { _%>
  readonly dialogOpen = signal(false)
<%_ } _%>
<%_ if (features.delete) { _%>
  readonly deleteDialogOpen = signal(false)
<%_ } _%>

  /** Filas derivadas del modelo: el generador decide qué se ve y en qué orden. */
  readonly rows: DetailRow[] = [
<%_ detail.rows.forEach(row => { _%>
    <%- row %>,
<%_ }) _%>
  ]

  constructor() {
    void this.load()
  }

  async load(): Promise<void> {
    const id = this._route.snapshot.paramMap.get('id')
    if (!id) {
      this.notFound.set(true)
      this.loading.set(false)
      return
    }
    try {
      this.<%- propertyName %>.set(await this._service.findOne(id))
<%_ if (features.history) { _%>
      this.history.set(await this._service.history(id))
<%_ } _%>
    } catch (e) {
      const status = (e as { status?: number }).status
      if (status === 404) this.notFound.set(true)
      else this.error.set(true)
    } finally {
      this.loading.set(false)
    }
  }

  back(): void {
    void this._router.navigate(['<%- route %>'])
  }
<%_ if (features.history) { _%>

  readonly history = signal<AuditEventDto[]>([])

  private readonly actionLabels: Record<AuditEventDto['action'], string> = {
    created: 'Creado',
    updated: 'Actualizado',
    deleted: 'Eliminado',
    restored: 'Restaurado'
  }

  actionLabel(event: AuditEventDto): string {
    return this.actionLabels[event.action]
  }

  when(event: AuditEventDto): string {
    // el instante lleva hora: formatValue solo cubre fechas de calendario
    return new Date(event.occurredAt).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' })
  }

  changedFields(event: AuditEventDto): { field: string; from: string; to: string }[] {
    return Object.entries(event.changes).map(([field, change]) => ({
      field,
      from: formatValue(change.from),
      to: formatValue(change.to)
    }))
  }
<%_ } _%>

  /** Un valor se lee igual aquí que en el listado: mismo formateador (kernel). */
  format(item: <%- dtoName %>, row: DetailRow): string {
    const value = (item as unknown as Record<string, unknown>)[row.key]
    return formatValue(value, { type: row.type, labels: row.labels })
  }

<%_ if (features.edit) { _%>

  openEdit(item: <%- dtoName %>): void {
    this.<%- propertyName %>.set(item)
    this.dialogOpen.set(true)
  }

  async onSave(value: <%- className %>FormValue): Promise<void> {
    const current = this.<%- propertyName %>()
    if (!current) return
    try {
      await this._service.update(current.id, value)
      this.dialogOpen.set(false)
      this._notify.success('<%- ui.toastUpdated %>')
      await this.load()
    } catch {
      this._notify.error('<%- ui.toastUpdateError %>')
    }
  }
<%_ } _%>
<%_ if (features.delete) { _%>

  deleteDescription(): string {
    const current = this.<%- propertyName %>()
    return current ? `<%- ui.deleteDescriptionPrefix %> «${current.<%- detail.titleField %>}»<%- ui.deleteDescriptionSuffix %>` : ''
  }

  async onDelete(): Promise<void> {
    const current = this.<%- propertyName %>()
    this.deleteDialogOpen.set(false)
    if (!current) return
    try {
      await this._service.remove(current.id)
      this._notify.success('<%- ui.toastDeleted %>')
      this.back()
    } catch {
      this._notify.error('<%- ui.toastDeleteError %>')
    }
  }
<%_ } _%>

<%_ if (entry.transitions.length) { _%>

  /** Una transición en vuelo deshabilita todos los botones: no hay dobles saltos. */
  readonly transitioning = signal(false)
<%_ entry.transitions.forEach(transition => { _%>

  /** Transición «<%- transition.label %>» (spec 43): un 409 es el estado rechazándola — avisa y recarga. */
  async <%- transition.method %>(id: string): Promise<void> {
    this.transitioning.set(true)
    try {
      await this._service.<%- transition.method %>(id)
    } catch (e) {
      const message = (e as { error?: { message?: string } }).error?.message
      this._notify.error(message ?? 'No se pudo aplicar «<%- transition.label %>»')
    } finally {
      this.transitioning.set(false)
      await this.load()
    }
  }
<%_ }) _%>
<%_ } _%>

  // @ai:begin detail-extra — bloques propios de esta ficha (relaciones, acciones de dominio)
  // @ai:end
}
