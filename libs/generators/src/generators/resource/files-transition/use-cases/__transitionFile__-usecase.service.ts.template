import { Injectable } from '@nestjs/common'
import { ConcurrencyConflictError, EntityNotFoundError } from '../../../../../shared/domain/errors'
import { <%- className %>Repository } from '../../domain/<%- fileName %>-repository'
import { <%- className %>Id } from '../../../../../shared/domain/value-objects/<%- plural %>/<%- fileName %>-id.vo'

/** Transición «<%- transition.label %>» de la máquina de estados (spec 43): cargar → transicionar → guardar. */
@Injectable()
export class <%- transition.className %>UseCase {
  constructor(private readonly <%- propertyName %>Repository: <%- className %>Repository) {}

  async invoke(input: { id: string; version: number }): Promise<void> {
    const <%- propertyName %>Id = <%- className %>Id.create(input.id)
    const <%- propertyName %> = await this.<%- propertyName %>Repository.get(<%- propertyName %>Id)

    if (!<%- propertyName %>) {
      throw new EntityNotFoundError('<%- className %>', input.id)
    }

    // Bloqueo optimista (spec 78): dos transiciones simultáneas — la segunda choca con 409
    if (input.version !== <%- propertyName %>.version) {
      throw new ConcurrencyConflictError('<%- className %>', input.id)
    }

    <%- propertyName %>.<%- transition.method %>()
    await this.<%- propertyName %>Repository.save(<%- propertyName %>)
  }
}
