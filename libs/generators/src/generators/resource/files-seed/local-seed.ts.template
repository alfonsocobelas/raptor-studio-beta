import 'reflect-metadata'
import { Module } from '@nestjs/common'
import { NestFactory } from '@nestjs/core'
import { CoreConfigModule } from '../../../../../shared/infrastructure/config/config.module'
import { LoggerModule } from '../../../../../shared/infrastructure/logger/logger.module'
import { SharedPersistenceModule } from '../../../../../shared/infrastructure/persistence/<%- persistenceDir %>/shared-persistence.module'
import { Register<%- className %>UseCase } from '../../application/use-cases/register-<%- fileName %>-usecase.service'
import { <%- pluralClassName %>Module } from '../../<%- plural %>.module'
import { <%- entry.seedConst %> } from './local-seed.fixtures'
import { <%- className %>LocalSeeder } from './local-seeder'

@Module({
  imports: [CoreConfigModule, LoggerModule, SharedPersistenceModule, <%- pluralClassName %>Module]
})
class <%- className %>SeedModule {}

async function bootstrap(): Promise<void> {
  const env = process.env['NODE_ENV']
  if (env !== 'local') {
    throw new Error(`Local seed can only run with NODE_ENV=local (got: ${env ?? 'undefined'})`)
  }

  const context = await NestFactory.createApplicationContext(<%- className %>SeedModule, { logger: ['error', 'warn'] })
  try {
    const register<%- className %> = context.get(Register<%- className %>UseCase)
    const seeder = new <%- className %>LocalSeeder(register<%- className %>)

    const summary = await seeder.seed(<%- entry.seedConst %>)

    console.log(`[seed] <%- plural %>: +${summary.<%- plural %>Created} created, ${summary.<%- plural %>Skipped} skipped`)
  } finally {
    await context.close()
  }
}

bootstrap().catch((error: unknown) => {
  console.error('[seed] failed:', error)
  process.exit(1)
})
