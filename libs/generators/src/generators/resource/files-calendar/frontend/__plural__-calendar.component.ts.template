import { ChangeDetectionStrategy, Component, computed, DestroyRef, inject, linkedSignal, signal } from '@angular/core'
<%_ if (detail) { _%>
import { Router } from '@angular/router'
<%_ } _%>
import { <%- dtoName %> } from '<%- sharedDomainAlias %>'
<%_ if (features.edit) { _%>
import { NotificationService } from '../../../../../../shared/components/ui/notification.service'
import { AppDialog } from '../../../../../../shared/components/ui/dialog'
import { AuthService } from '../../../../../../core/services/auth.service'
<%_ } _%>
import { <%- className %>Service, OffsetPaginatedOutput } from '../../../../../../core/services/<%- fileName %>.service'
<%_ if (features.edit && entry.accessDeclared) { _%>
import { <%- detail ? 'CAN_CREATE_ROLES' : 'CAN_CREATE_ROLES, CAN_EDIT_ROLES' %> } from './<%- fileName %>-access'
<%_ } _%>
<%_ if (features.edit) { _%>
import { generateId } from '../../../../../../shared/utils/uuid'
import { <%- className %>DialogComponent, <%- className %>FormValue } from './<%- fileName %>-dialog.component'
<%_ } _%>
import { formatValue } from '../../../../../../shared/utils/format-value'

type CalendarView = 'month' | 'week' | 'day'

interface CalendarCell {
  key: string
  dayNumber: number
  inPeriod: boolean
  isToday: boolean
  strips: <%- dtoName %>[]
}

/**
 * Calendario de <%- ui.title %>: la MISMA lectura del listado, con cada registro
 * como tira en su día. Comparte servicio y estado — no hay endpoint propio.
 */
@Component({
  selector: 'app-<%- plural %>-calendar',
  imports: [<%- features.edit ? 'AppDialog, ' + className + 'DialogComponent' : '' %>],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="min-w-0 space-y-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight"><%- ui.title %></h1>
        <p class="text-muted-foreground"><%- ui.subtitle %></p>
      </div>

      @if (isLoading() && !hasData()) {
        <p class="text-muted-foreground py-12 text-center text-sm"><%- ui.loading %></p>
      } @else if (error()) {
        <p class="text-destructive py-12 text-center text-sm"><%- ui.error %></p>
      } @else {
        <div class="bg-card rounded-lg border">
          <div class="flex items-center justify-between border-b px-4 py-3">
            <h2 class="text-base font-semibold"><%- ui.title %></h2>
            <div class="flex items-center gap-1 text-sm">
              <button type="button" class="text-muted-foreground px-2 py-1 hover:text-foreground" (click)="previousPeriod()" aria-label="Anterior">‹</button>
              <span class="min-w-28 text-center text-xs font-medium uppercase tracking-widest">{{ periodLabel() }}</span>
              <button type="button" class="text-muted-foreground px-2 py-1 hover:text-foreground" (click)="nextPeriod()" aria-label="Siguiente">›</button>
            </div>
          </div>

          @if (view() !== 'day') {
            <div class="grid" [style.grid-template-columns]="'repeat(' + dayNames.length + ', minmax(0, 1fr))'">
              @for (name of dayNames; track name) {
                <div class="text-muted-foreground border-b px-2 py-1 text-center text-[10px] tracking-widest">{{ name }}</div>
              }
              @for (cell of cells(); track cell.key) {
                <div
                  class="group min-h-20 border-b border-r p-1 last:border-r-0"
                  [class.opacity-40]="!cell.inPeriod"
                  [class.ring-1]="cell.isToday"
                  [class.ring-primary]="cell.isToday"
                >
                  <span class="text-xs" [class.text-primary]="cell.isToday" [class.font-semibold]="cell.isToday">{{ cell.dayNumber }}</span>
<%_ if (features.edit) { _%>
                  @if (<%- entry.canCreateExpr %>) {
                    <button
                      type="button"
                      class="text-muted-foreground hover:text-foreground float-right px-1 text-xs opacity-0 focus:opacity-100 group-hover:opacity-100"
                      (click)="openCreate(cell.key)"
                      aria-label="<%- ui.createLabel %>"
                    >
                      +
                    </button>
                  }
<%_ } _%>
                  <div class="mt-1 space-y-1">
                    @for (item of cell.strips; track item.id) {
                      <div
                        class="bg-muted truncate rounded-sm border-l-2 px-1 py-0.5 text-xs"
                        [style.border-left-color]="stripColor(item)"
<%_ if (detail) { _%>
                        role="button"
                        tabindex="0"
                        (click)="open(item)"
                        (keydown.enter)="open(item)"
<%_ } else if (features.edit) { _%>
                        role="button"
                        tabindex="0"
                        (click)="edit(item)"
                        (keydown.enter)="edit(item)"
<%_ } _%>
                      >
                        {{ text(item, stripLabel) }}
                      </div>
                    }
                  </div>
                </div>
              }
            </div>
          } @else {
            <div class="space-y-1 p-4">
<%_ if (features.edit) { _%>
              @if (<%- entry.canCreateExpr %>) {
                <button
                  type="button"
                  class="text-muted-foreground hover:text-foreground mb-2 text-xs uppercase tracking-widest"
                  (click)="openCreate(anchorKey())"
                >
                  + <%- ui.createLabel %>
                </button>
              }
<%_ } _%>
              @for (item of dayStrips(); track item.id) {
                <div
                  class="bg-muted rounded-sm border-l-2 px-2 py-1 text-sm"
                  [style.border-left-color]="stripColor(item)"
<%_ if (detail) { _%>
                  role="button"
                  tabindex="0"
                  (click)="open(item)"
                  (keydown.enter)="open(item)"
<%_ } else if (features.edit) { _%>
                  role="button"
                  tabindex="0"
                  (click)="edit(item)"
                  (keydown.enter)="edit(item)"
<%_ } _%>
                >
                  {{ text(item, stripLabel) }}
                </div>
              } @empty {
                <p class="text-muted-foreground py-8 text-center text-sm"><%- ui.empty %></p>
              }
            </div>
          }

          <div class="text-muted-foreground flex items-center justify-between border-t px-4 py-2 text-[10px] uppercase tracking-widest">
            <span><%- labelPlural %> · campo fecha <%- calendar.dateLabel %></span>
            <div class="flex gap-2">
              @for (option of viewOptions; track option.value) {
                <button
                  type="button"
                  class="uppercase tracking-widest"
                  [class.text-foreground]="view() === option.value"
                  [class.font-semibold]="view() === option.value"
                  (click)="view.set(option.value)"
                >
                  {{ option.label }}
                </button>
              }
            </div>
          </div>
        </div>

<%_ if (calendar.colorField) { _%>
        <div class="flex flex-wrap gap-3 text-sm">
          @for (entry of legend; track entry.value) {
            <span class="bg-card inline-flex items-center gap-2 rounded-md border px-3 py-1">
              <span class="size-2.5 rounded-sm" [style.background-color]="colorOf(entry.colorIndex)"></span>
              {{ entry.label }}
            </span>
          }
        </div>
<%_ } _%>
        <p class="text-muted-foreground text-sm">{{ total() }} en total</p>
      }
    </div>
<%_ if (features.edit) { _%>

    <app-dialog [open]="dialogOpen()" (closed)="dialogOpen.set(false)">
      @if (dialogOpen()) {
        <app-<%- fileName %>-dialog
          [<%- propertyName %>]="editing<%- className %>()"
          [initialValue]="createInitial()"
          (saved)="onSave($event)"
          (close)="dialogOpen.set(false)"
        />
      }
    </app-dialog>
<%_ } _%>
  `
})
export class <%- pluralClassName %>CalendarComponent {
  private readonly _service = inject(<%- className %>Service)
<%_ if (detail) { _%>
  private readonly _router = inject(Router)
<%_ } _%>
<%_ if (features.edit) { _%>
  private readonly _notify = inject(NotificationService)
<%_ if (entry.accessDeclared) { _%>
  private readonly _sessionUser = inject(AuthService).currentUser
  // La matriz granular (spec 49): el alta obedece a los mismos roles que su @Roles emitido
  protected readonly canCreate = computed(() => {
    const role = this._sessionUser()?.role
    return role !== undefined && CAN_CREATE_ROLES.includes(role)
  })
<%_ if (!detail) { _%>
  protected readonly canEdit = computed(() => {
    const role = this._sessionUser()?.role
    return role !== undefined && CAN_EDIT_ROLES.includes(role)
  })
<%_ } _%>
<%_ } else { _%>
  protected readonly canWrite = inject(AuthService).canWrite
<%_ } _%>
<%_ } _%>

  /** Campos que pinta la tira: los decide el generador desde el modelo. */
  readonly stripDate = '<%- calendar.dateField %>'
  readonly stripLabel = '<%- calendar.labelField %>'
<%_ if (calendar.colorField) { _%>
  readonly stripColorField = '<%- calendar.colorField %>'
  readonly legend: { value: string; label: string; colorIndex: number }[] = [
<%_ calendar.legend.forEach(entry => { _%>
    { value: '<%- entry.value %>', label: '<%- entry.label %>', colorIndex: <%- entry.colorIndex %> },
<%_ }) _%>
  ]
<%_ } _%>
  readonly weekends = <%- calendar.weekends %>
  readonly dayNames: string[] = [<%- calendar.dayNames.map(name => `'${name}'`).join(', ') %>]
  readonly viewOptions: { value: CalendarView; label: string }[] = [
    { value: 'month', label: 'Mes' },
    { value: 'week', label: 'Semana' },
    { value: 'day', label: 'Día' }
  ]

  readonly view = signal<CalendarView>('month')
  readonly anchor = signal(new Date())
<%_ if (features.edit) { _%>

  readonly dialogOpen = signal(false)
  readonly editing<%- className %> = signal<<%- dtoName %> | null>(null)
  /** El día pulsado (clave yyyy-mm-dd): precarga el campo fecha del alta. */
  readonly createDate = signal<string | null>(null)
  readonly createInitial = computed<Partial<<%- className %>FormValue> | null>(() => {
    const date = this.createDate()
    return date === null ? null : { <%- calendar.dateField %>: date }
  })
  readonly anchorKey = computed(() => this._keyOf(this.anchor()))
<%_ } _%>

  readonly isLoading = this._service.<%- plural %>.isLoading
  readonly error = this._service.<%- plural %>.error

  constructor() {
    // El calendario pinta TODOS los registros, no una página: ensancha la lectura
    // compartida y la restaura al salir para no ensuciar el paginado del listado.
    const previous = this._service.request()
    this._service.request.update(r => ({ ...r, page: 1, pageSize: 500 }))
    inject(DestroyRef).onDestroy(() => {
      this._service.request.update(r => ({ ...r, page: previous.page, pageSize: previous.pageSize }))
    })
  }

  // Igual que el listado: al recargar, resource() vacía value(); conservar la última
  // página evita que la rejilla parpadee en cada navegación.
  private readonly _loaded = linkedSignal<
    OffsetPaginatedOutput<<%- dtoName %>> | undefined,
    OffsetPaginatedOutput<<%- dtoName %>> | undefined
  >({
    source: () => this._service.<%- plural %>.value(),
    computation: (value, previous) => value ?? previous?.value
  })

  readonly items = computed(() => this._loaded()?.items ?? [])
  readonly total = computed(() => this._loaded()?.total ?? 0)
  readonly hasData = computed(() => this._loaded() !== undefined)

  /** Registros agrupados por su día (clave yyyy-mm-dd del campo fecha). */
  private readonly _byDay = computed(() => {
    const map = new Map<string, <%- dtoName %>[]>()
    for (const item of this.items()) {
      const raw = (item as unknown as Record<string, unknown>)[this.stripDate]
      if (typeof raw !== 'string' || raw.length < 10) continue
      const key = raw.slice(0, 10)
      map.set(key, [...(map.get(key) ?? []), item])
    }
    return map
  })

  readonly periodLabel = computed(() => {
    const anchor = this.anchor()
    if (this.view() === 'day') {
      return anchor.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase()
    }
    return anchor.toLocaleDateString('es-ES', { month: 'short', year: 'numeric' }).toUpperCase()
  })

  readonly cells = computed<CalendarCell[]>(() =>
    this.view() === 'month' ? this._monthCells() : this._weekCells()
  )

  readonly dayStrips = computed(() => this._byDay().get(this._keyOf(this.anchor())) ?? [])

  text(item: <%- dtoName %>, key: string): string {
    return formatValue((item as unknown as Record<string, unknown>)[key])
  }

  stripColor(item: <%- dtoName %>): string {
<%_ if (calendar.colorField) { _%>
    const value = (item as unknown as Record<string, unknown>)[this.stripColorField]
    const entry = this.legend.find(e => e.value === value)
    return entry ? this.colorOf(entry.colorIndex) : 'var(--foreground)'
<%_ } else { _%>
    return 'var(--foreground)'
<%_ } _%>
  }

<%_ if (calendar.colorField) { _%>
  /** Paleta por posición del valor del enum: determinista e independiente del idioma. */
  colorOf(index: number): string {
    const palette = ['var(--foreground)', 'var(--destructive)', 'var(--primary)', 'var(--muted-foreground)']
    return palette[index % palette.length]
  }

<%_ } _%>
<%_ if (features.edit) { _%>
  openCreate(day: string): void {
    this.editing<%- className %>.set(null)
    this.createDate.set(day)
    this.dialogOpen.set(true)
  }

<%_ if (!detail) { _%>
  /** Sin ficha, la tira edita en el mismo diálogo del listado; la guardia replica al @Roles del update. */
  edit(item: <%- dtoName %>): void {
    if (!<%- entry.canEditExpr %>) {
      return
    }
    this.editing<%- className %>.set(item)
    this.createDate.set(null)
    this.dialogOpen.set(true)
  }

<%_ } _%>
  async onSave(value: <%- className %>FormValue): Promise<void> {
    const editing = this.editing<%- className %>()
    this.dialogOpen.set(false)
    try {
      if (editing) {
        await this._service.update(editing.id, value)
        this._notify.success('<%- ui.toastUpdated %>')
      } else {
        await this._service.create({ id: generateId(), ...value })
        this._notify.success('<%- ui.toastCreated %>')
      }
    } catch {
      this._notify.error(editing ? '<%- ui.toastUpdateError %>' : '<%- ui.toastCreateError %>')
    }
  }

<%_ } _%>
  previousPeriod(): void {
    this.anchor.update(anchor => this._shift(anchor, -1))
  }

  nextPeriod(): void {
    this.anchor.update(anchor => this._shift(anchor, 1))
  }

  private _shift(anchor: Date, direction: number): Date {
    const next = new Date(anchor)
    if (this.view() === 'month') next.setMonth(next.getMonth() + direction)
    else if (this.view() === 'week') next.setDate(next.getDate() + direction * 7)
    else next.setDate(next.getDate() + direction)
    return next
  }

  private _monthCells(): CalendarCell[] {
    const anchor = this.anchor()
    const first = new Date(anchor.getFullYear(), anchor.getMonth(), 1)
    const start = this._startOfWeek(first)
    const last = new Date(anchor.getFullYear(), anchor.getMonth() + 1, 0)
    const cells: CalendarCell[] = []
    for (let day = new Date(start); day <= last || day.getDay() !== 1; day.setDate(day.getDate() + 1)) {
      if (!this.weekends && (day.getDay() === 0 || day.getDay() === 6)) continue
      cells.push(this._cellOf(day, day.getMonth() === anchor.getMonth()))
      if (cells.length > 42) break
    }
    return cells
  }

  private _weekCells(): CalendarCell[] {
    const start = this._startOfWeek(this.anchor())
    const cells: CalendarCell[] = []
    for (let offset = 0; offset < 7; offset++) {
      const day = new Date(start)
      day.setDate(day.getDate() + offset)
      if (!this.weekends && (day.getDay() === 0 || day.getDay() === 6)) continue
      cells.push(this._cellOf(day, true))
    }
    return cells
  }

  private _cellOf(day: Date, inPeriod: boolean): CalendarCell {
    const key = this._keyOf(day)
    return {
      key,
      dayNumber: day.getDate(),
      inPeriod,
      isToday: key === this._keyOf(new Date()),
      strips: this._byDay().get(key) ?? []
    }
  }

  /** Lunes de la semana del día dado. */
  private _startOfWeek(day: Date): Date {
    const start = new Date(day)
    start.setDate(start.getDate() - ((start.getDay() + 6) % 7))
    return start
  }

  private _keyOf(day: Date): string {
    const month = String(day.getMonth() + 1).padStart(2, '0')
    const dayOfMonth = String(day.getDate()).padStart(2, '0')
    return `${day.getFullYear()}-${month}-${dayOfMonth}`
  }
<%_ if (detail) { _%>

  open(item: <%- dtoName %>): void {
    void this._router.navigate(['<%- route %>', item.id])
  }
<%_ } _%>

  // @ai:begin calendar-extra — filtros o adornos propios de este calendario
  // @ai:end
}
