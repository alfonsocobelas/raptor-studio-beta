import { v7 as uuidv7 } from 'uuid'
import { moduleFixture } from '../jest.setup.integration'
import { Mongoose<%- className %>Repository } from '../../../src/contexts/<%- context %>/modules/<%- plural %>/infrastructure/persistence/mongoose/mongoose-<%- fileName %>.repository'
import { <%- className %>WithIdSpecification } from '../../../src/contexts/<%- context %>/modules/<%- plural %>/domain/specifications/<%- fileName %>-with-id.specification'
import { <%- className %>Id } from '../../../src/contexts/shared/domain/value-objects/<%- plural %>/<%- fileName %>-id.vo'
<%_ domainTests.uniqueFinders.forEach(f => { _%>
<%_ if (f.shared) { _%>
import { <%- f.voName %> } from '../../../src/contexts/<%- context %>/shared/domain/value-objects/<%- f.voFileName %>.vo'
<%_ } else { _%>
import { <%- f.voName %> } from '../../../src/contexts/<%- context %>/modules/<%- plural %>/domain/value-objects/<%- f.voFileName %>.vo'
<%_ } _%>
<%_ }) _%>
import { <%- className %>Mother } from '../../modules/<%- plural %>/domain/mothers/<%- fileName %>.mother'
<%_ if (mongo.optionalUniques.length) { _%>
import { <%- className %>Builder } from '../../modules/<%- plural %>/domain/mothers/<%- fileName %>.builder'
<%_ } _%>

let repository: Mongoose<%- className %>Repository

beforeAll(() => {
  repository = moduleFixture.get(Mongoose<%- className %>Repository)
})

// Espejo del test de integración TypeORM: mismo puerto, mismas garantías. Corre contra un
// Mongo real (el del compose de test), no contra un doble.
describe('Mongoose<%- className %>Repository (integration)', () => {
  describe('register / get', () => {
    it('persists a new <%- fileName %> and reads it back', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()

      await repository.register(<%- propertyName %>)
      const found = await repository.get(<%- propertyName %>.id)

      expect(found?.toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
    })

    it('returns null for a non-existent id', async () => {
      const found = await repository.get(<%- className %>Id.create(uuidv7()))
      expect(found).toBeNull()
    })
<%_ if (mongo.child) { _%>

    it('keeps the embedded <%- mongo.child.childrenProp %> inside the aggregate document', async () => {
      // la composición viaja EMBEBIDA: un solo documento, sin segunda colección
      const <%- propertyName %> = <%- className %>Mother.random()

      await repository.register(<%- propertyName %>)
      const found = await repository.get(<%- propertyName %>.id)

      expect(found?.<%- mongo.child.childrenProp %>).toHaveLength(<%- propertyName %>.<%- mongo.child.childrenProp %>.length)
    })
<%_ } _%>
  })
<%_ domainTests.uniqueFinders.forEach(f => { _%>

  describe('<%- f.method %>', () => {
    it('finds a persisted <%- fileName %> by its <%- f.param %>', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const found = await repository.<%- f.method %>(<%- f.voName %>.create(<%- propertyName %>.toPrimitives().<%- f.param %><% if (f.nullable) { %> ?? ''<% } %>))

      expect(found?.toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
    })

    it('returns null when no <%- fileName %> has that <%- f.param %>', async () => {
      // los valores de la mother son aleatorios: este nunca se registró
      const unregistered = <%- className %>Mother.random()

      const found = await repository.<%- f.method %>(<%- f.voName %>.create(unregistered.toPrimitives().<%- f.param %><% if (f.nullable) { %> ?? ''<% } %>))

      expect(found).toBeNull()
    })
  })
<%_ }) _%>

  describe('matching / exists / count', () => {
    it('matching returns the <%- fileName %> selected by criteria', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const results = await repository.matching(<%- className %>WithIdSpecification.withId(<%- propertyName %>.id))

      expect(results).toHaveLength(1)
      expect(results[0].toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
    })

    it('exists / count reflect the persisted documents', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const spec = <%- className %>WithIdSpecification.withId(<%- propertyName %>.id)
      expect(await repository.exists(spec)).toBe(true)
      expect(await repository.count(spec)).toBe(1)

      const absent = <%- className %>WithIdSpecification.withId(<%- className %>Id.create(uuidv7()))
      expect(await repository.exists(absent)).toBe(false)
      expect(await repository.count(absent)).toBe(0)
    })
  })

<%_ if (mongo.optionalUniques.length) { _%>
  describe('unique opcional (partialFilterExpression)', () => {
<%_ mongo.optionalUniques.forEach(field => { _%>
    it('admite varios <%- fileName %> con <%- field %> vacío sin que choque el índice único', async () => {
      // el índice de <%- field %> es parcial: solo indexa los documentos que lo traen con valor,
      // así que los vacíos no compiten entre sí (equivalente al partial unique index de Postgres)
      const first = <%- className %>Builder.a<%- className %>().withProps({ <%- field %>: '' }).create()
      const second = <%- className %>Builder.a<%- className %>().withProps({ <%- field %>: '' }).create()

      await repository.register(first)
      await repository.register(second)

      expect((await repository.get(second.id))?.toPrimitives().<%- field %>).toBe('')
    })

    it('sigue rechazando dos <%- fileName %> con el mismo <%- field %> con valor', async () => {
      const value = <%- className %>Mother.random().toPrimitives().<%- field %>
      await repository.register(<%- className %>Builder.a<%- className %>().withProps({ <%- field %>: value }).create())

      await expect(
        repository.register(<%- className %>Builder.a<%- className %>().withProps({ <%- field %>: value }).create())
      ).rejects.toThrow(/already exists/i)
    })
<%_ }) _%>
  })

<%_ } _%>
  describe('save', () => {
    it('replaces the whole document instead of inserting a second one', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      await repository.save(<%- propertyName %>)

      expect(await repository.count(<%- className %>WithIdSpecification.withId(<%- propertyName %>.id))).toBe(1)
    })
  })
<%_ if (app.removes) { _%>

  describe('remove', () => {
    it('removes a persisted <%- fileName %>', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      await repository.remove(<%- propertyName %>.id)

      expect(await repository.get(<%- propertyName %>.id)).toBeNull()
    })
  })
<%_ } _%>
<%_ if (app.trash) { _%>

  describe('trash', () => {
    it('a removed <%- fileName %> leaves matching and shows up in matchingDeleted', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)
      await repository.remove(<%- propertyName %>.id)

      const spec = <%- className %>WithIdSpecification.withId(<%- propertyName %>.id)
      expect(await repository.matching(spec)).toHaveLength(0)

      const deleted = await repository.matchingDeleted(spec)
      expect(deleted).toHaveLength(1)
      expect(deleted[0].toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
      expect(await repository.countDeleted(spec)).toBe(1)
    })

    it('restore brings it back; a live or unknown id restores nothing', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)
      await repository.remove(<%- propertyName %>.id)

      expect(await repository.restore(<%- propertyName %>.id)).toBe(true)
      expect(await repository.get(<%- propertyName %>.id)).not.toBeNull()

      // ya está vivo: restaurarlo otra vez no encuentra nada borrado
      expect(await repository.restore(<%- propertyName %>.id)).toBe(false)
      expect(await repository.restore(<%- className %>Id.create(uuidv7()))).toBe(false)
    })
  })
<%_ } _%>
})
