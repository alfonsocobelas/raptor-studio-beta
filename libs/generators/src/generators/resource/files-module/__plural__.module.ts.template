import { Module } from '@nestjs/common'
<%_ entry.moduleHandlerImports.forEach(line => { _%>
<%- line %>
<%_ }) _%>
<%_ entry.moduleUseCaseImports.forEach(line => { _%>
<%- line %>
<%_ }) _%>
import { <%- className %>Repository } from './domain/<%- fileName %>-repository'
import { <%- pluralClassName %>Controller } from './infrastructure/entrypoints/<%- plural %>.controller'
<%_ if (aggregate.composition) { _%>
import { <%- entry.childControllerClass %> } from './infrastructure/entrypoints/<%- entry.childControllerFile %>.controller'
<%_ } _%>
import { <%- repository.className %> } from '<%- repository.importPath %>'
<%_ if (app.history) { _%>
import { AuditModule } from '../../../shared/infrastructure/audit/audit.module'
<%_ } _%>
<%_ dragModules.forEach(m => { _%>
<%- m.importLine %>
<%_ }) _%>
<%_ if (attachments) { _%>
import { TypeOrmModule } from '@nestjs/typeorm'
import { StorageModule } from '../../../shared/infrastructure/storage/storage.module'
import { TypeOrm<%- className %>AttachmentEntity } from './infrastructure/attachments/<%- fileName %>-attachment.entity'
import { <%- className %>AttachmentsController } from './infrastructure/attachments/<%- fileName %>-attachments.controller'
import { <%- className %>AttachmentsService } from './infrastructure/attachments/<%- fileName %>-attachments.service'
<%_ } _%>

@Module({
<%_ if (attachments && app.history) { _%>
  // StorageModule y AuditModule explícitos (no se confía en @Global): así el módulo
  // funciona en cualquier contexto Nest — API, seed o tests — sin depender del root.
  imports: [TypeOrmModule.forFeature([TypeOrm<%- className %>AttachmentEntity]), StorageModule, AuditModule<%- dragModules.map(m => ', ' + m.className).join('') %>],
<%_ } else if (attachments) { _%>
  // StorageModule explícito (no se confía en @Global): así el módulo funciona en
  // cualquier contexto Nest — API, seed o tests — sin depender del root.
  imports: [TypeOrmModule.forFeature([TypeOrm<%- className %>AttachmentEntity]), StorageModule<%- dragModules.map(m => ', ' + m.className).join('') %>],
<%_ } else if (app.history) { _%>
  // AuditModule explícito (no se confía en @Global): el historial funciona también en seed y tests.
  imports: [AuditModule<%- dragModules.map(m => ', ' + m.className).join('') %>],
<%_ } else if (dragModules.length) { _%>
  // Los módulos del árbol de arrastre (spec 38): el borrado del padre marca a sus hijos
  // por sus PORTS, así que la DI cruza módulos — cada hijo ya exporta su repositorio.
  imports: [<%- dragModules.map(m => m.className).join(', ') %>],
<%_ } _%>
<%_ if (attachments) { _%>
  // el controller de adjuntos va PRIMERO: Nest resuelve rutas por orden de registro
  // y '<%- plural %>/attachments' colisionaría con '<%- plural %>/:id' del recurso
<%_ } _%>
  controllers: [<% if (attachments) { %><%- className %>AttachmentsController, <% } %><%- pluralClassName %>Controller<% if (aggregate.composition) { %>, <%- entry.childControllerClass %><% } %>],
  providers: [
<%_ if (attachments) { _%>
    <%- className %>AttachmentsService,
<%_ } _%>
<%_ entry.moduleProviderNames.forEach(name => { _%>
    <%- name %>,
<%_ }) _%>
    { provide: <%- className %>Repository, useClass: <%- repository.className %> }
  ],
  exports: [<%- className %>Repository]
})
export class <%- pluralClassName %>Module {}
