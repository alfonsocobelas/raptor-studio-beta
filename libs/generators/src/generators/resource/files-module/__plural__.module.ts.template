import { Module } from '@nestjs/common'
<%_ entry.moduleHandlerImports.forEach(line => { _%>
<%- line %>
<%_ }) _%>
<%_ entry.moduleUseCaseImports.forEach(line => { _%>
<%- line %>
<%_ }) _%>
import { <%- className %>Repository } from './domain/<%- fileName %>-repository'
import { <%- pluralClassName %>Controller } from './infrastructure/entrypoints/<%- plural %>.controller'
