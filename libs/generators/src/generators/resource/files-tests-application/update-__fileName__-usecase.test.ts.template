<%_ if (app.history) { _%>
import { AuditTrailPort } from '../../../../../src/contexts/shared/domain/audit/audit-trail.port'
<%_ } _%>
import { v7 as uuidv7 } from 'uuid'
import { Update<%- className %>UseCase } from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/use-cases/update-<%- fileName %>-usecase.service'
import { <%- app.hasUniqueChecks ? 'AlreadyExistsError, ' : '' %>ConcurrencyConflictError, EntityNotFoundError } from '../../../../../src/contexts/shared/domain/errors'
<%_ app.testDenormImports.forEach(line => { _%>
<%- line %>
<%_ }) _%>
import { <%- className %>Mother } from '../../domain/mothers/<%- fileName %>.mother'
import { <%- className %>RepositoryMock } from '../../mocks/<%- fileName %>.repository.mock'

describe('Update<%- className %>UseCase', () => {
  let repositoryMock: <%- className %>RepositoryMock
  let useCase: Update<%- className %>UseCase
<%_ if (app.history) { _%>
  const auditTrail = { record: jest.fn(), of: jest.fn() } as unknown as AuditTrailPort
<%_ } _%>
<%_ app.testDenormMockDecls.forEach(line => { _%>
<%- line %>
<%_ }) _%>

  beforeEach(() => {
    repositoryMock = new <%- className %>RepositoryMock()
<%_ app.testDenormBeforeEachLines.forEach(line => { _%>
<%- line %>
<%_ }) _%>
    useCase = new Update<%- className %>UseCase(repositoryMock<% if (app.history) { %>, auditTrail<% } %><%- app.testDenormCtorArgs %>)
  })

  describe('given the <%- fileName %> does not exist', () => {
    it('throws EntityNotFoundError and does not save', async () => {
      repositoryMock.givenNotFound()

      await expect(useCase.invoke({ id: uuidv7(), version: 1, updates: {} })).rejects.toThrow(EntityNotFoundError)
      repositoryMock.assertNotCalled('save')
    })
  })

  describe('given a stale version (bloqueo optimista, spec 78)', () => {
    it('throws ConcurrencyConflictError and does not mutate nor save', async () => {
      const current = <%- className %>Mother.reconstruct()
      repositoryMock.givenFound(current)
      const before = current.toPrimitives()

      await expect(useCase.invoke({ id: current.id.value, version: 99, updates: {} })).rejects.toThrow(
        ConcurrencyConflictError
      )

      repositoryMock.assertNotCalled('save')
      expect(current.toPrimitives()).toEqual(before)
    })
  })

  describe('given an update that touches no unique field', () => {
    it('saves without checking uniqueness', async () => {
      repositoryMock.givenFound(<%- className %>Mother.reconstruct())
      repositoryMock.whenSaveSuccess()

      await useCase.invoke({ id: uuidv7(), version: 1, updates: {} })

      repositoryMock.assertNotCalled('exists')
      repositoryMock.assertCalled('save')
    })
  })
<%_ app.uniqueSpecs.forEach(spec => { _%>

  describe('given <%- spec.field %> changes', () => {
    it('re-validates uniqueness and saves when the new value is free', async () => {
      const current = <%- className %>Mother.reconstruct()
      repositoryMock.givenFound(current)
      repositoryMock.givenDoesNotExist()
      repositoryMock.whenSaveSuccess()

      // los valores de la mother son aleatorios: uno nuevo difiere del actual
      await useCase.invoke({ id: current.id.value, version: 1, updates: { <%- spec.field %>: <%- className %>Mother.primitives().<%- spec.field %> } })

      repositoryMock.assertCalledTimes('exists', 1)
      repositoryMock.assertCalled('save')
    })

    it('throws AlreadyExistsError and does not save when the new value is taken', async () => {
      repositoryMock.givenFound(<%- className %>Mother.reconstruct())
      repositoryMock.givenAlreadyExists()

      await expect(
        useCase.invoke({ id: uuidv7(), version: 1, updates: { <%- spec.field %>: <%- className %>Mother.primitives().<%- spec.field %> } })
      ).rejects.toThrow(AlreadyExistsError)
      repositoryMock.assertNotCalled('save')
    })

    it('saves without checking uniqueness when the provided value is unchanged', async () => {
      const current = <%- className %>Mother.reconstruct()
      repositoryMock.givenFound(current)
      repositoryMock.whenSaveSuccess()

      await useCase.invoke({ id: current.id.value, version: 1, updates: { <%- spec.field %>: current.toPrimitives().<%- spec.field %> } })

      repositoryMock.assertNotCalled('exists')
      repositoryMock.assertCalled('save')
    })
  })
<%_ }) _%>
<%_ app.denorms.forEach(d => { _%>

  describe('given <%- d.fkField %> changes (denormalización, spec 60)', () => {
    it('refresca <%- d.targetField %> con el valor canónico del nuevo origen', async () => {
      const current = <%- className %>Mother.reconstruct()
      repositoryMock.givenFound(current)
      repositoryMock.whenSaveSuccess()
      const canonical = <%- className %>Mother.primitives().<%- d.targetField %>
      ;(<%- d.repoProp %>.get as jest.Mock).mockResolvedValue({ <%- d.labelField %>: { value: canonical } })

      await useCase.invoke({ id: current.id.value, version: 1, updates: { <%- d.fkField %>: uuidv7() } })

      repositoryMock.assertCalled('save')
      expect(current.toPrimitives().<%- d.targetField %>).toBe(canonical)
    })

    it('falla con EntityNotFoundError si el nuevo FK no existe y no guarda', async () => {
      repositoryMock.givenFound(<%- className %>Mother.reconstruct())
      ;(<%- d.repoProp %>.get as jest.Mock).mockResolvedValue(null)

      await expect(useCase.invoke({ id: uuidv7(), version: 1, updates: { <%- d.fkField %>: uuidv7() } })).rejects.toThrow(
        EntityNotFoundError
      )
      repositoryMock.assertNotCalled('save')
    })

    it('no consulta el origen si el FK no viene en updates', async () => {
      repositoryMock.givenFound(<%- className %>Mother.reconstruct())
      repositoryMock.whenSaveSuccess()
      ;(<%- d.repoProp %>.get as jest.Mock).mockClear()

      await useCase.invoke({ id: uuidv7(), version: 1, updates: {} })

      expect(<%- d.repoProp %>.get as jest.Mock).not.toHaveBeenCalled()
    })
  })
<%_ }) _%>
})
