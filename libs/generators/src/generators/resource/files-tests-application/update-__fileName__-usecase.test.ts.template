<%_ if (app.history) { _%>
import { AuditTrailPort } from '../../../../../src/contexts/shared/domain/audit/audit-trail.port'
<%_ } _%>
import { v7 as uuidv7 } from 'uuid'
import { Update<%- className %>UseCase } from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/use-cases/update-<%- fileName %>-usecase.service'
import { <%- app.hasUniqueChecks ? 'AlreadyExistsError, ' : '' %>EntityNotFoundError } from '../../../../../src/contexts/shared/domain/errors'
import { <%- className %>Mother } from '../../domain/mothers/<%- fileName %>.mother'
import { <%- className %>RepositoryMock } from '../../mocks/<%- fileName %>.repository.mock'

describe('Update<%- className %>UseCase', () => {
  let repositoryMock: <%- className %>RepositoryMock
  let useCase: Update<%- className %>UseCase
<%_ if (app.history) { _%>
  const auditTrail = { record: jest.fn(), of: jest.fn() } as unknown as AuditTrailPort
<%_ } _%>

  beforeEach(() => {
    repositoryMock = new <%- className %>RepositoryMock()
<%_ if (app.history) { _%>
    useCase = new Update<%- className %>UseCase(repositoryMock, auditTrail)
<%_ } else { _%>
    useCase = new Update<%- className %>UseCase(repositoryMock)
<%_ } _%>
  })

  describe('given the <%- fileName %> does not exist', () => {
    it('throws EntityNotFoundError and does not save', async () => {
      repositoryMock.givenNotFound()

      await expect(useCase.invoke({ id: uuidv7(), updates: {} })).rejects.toThrow(EntityNotFoundError)
      repositoryMock.assertNotCalled('save')
    })
  })

  describe('given an update that touches no unique field', () => {
    it('saves without checking uniqueness', async () => {
      repositoryMock.givenFound(<%- className %>Mother.reconstruct())
      repositoryMock.whenSaveSuccess()

      await useCase.invoke({ id: uuidv7(), updates: {} })

      repositoryMock.assertNotCalled('exists')
      repositoryMock.assertCalled('save')
    })
  })
<%_ app.uniqueSpecs.forEach(spec => { _%>

  describe('given <%- spec.field %> changes', () => {
    it('re-validates uniqueness and saves when the new value is free', async () => {
      const current = <%- className %>Mother.reconstruct()
      repositoryMock.givenFound(current)
      repositoryMock.givenDoesNotExist()
      repositoryMock.whenSaveSuccess()

      // los valores de la mother son aleatorios: uno nuevo difiere del actual
      await useCase.invoke({ id: current.id.value, updates: { <%- spec.field %>: <%- className %>Mother.primitives().<%- spec.field %> } })

      repositoryMock.assertCalledTimes('exists', 1)
      repositoryMock.assertCalled('save')
    })

    it('throws AlreadyExistsError and does not save when the new value is taken', async () => {
      repositoryMock.givenFound(<%- className %>Mother.reconstruct())
      repositoryMock.givenAlreadyExists()

      await expect(
        useCase.invoke({ id: uuidv7(), updates: { <%- spec.field %>: <%- className %>Mother.primitives().<%- spec.field %> } })
      ).rejects.toThrow(AlreadyExistsError)
      repositoryMock.assertNotCalled('save')
    })

    it('saves without checking uniqueness when the provided value is unchanged', async () => {
      const current = <%- className %>Mother.reconstruct()
      repositoryMock.givenFound(current)
      repositoryMock.whenSaveSuccess()

      await useCase.invoke({ id: current.id.value, updates: { <%- spec.field %>: current.toPrimitives().<%- spec.field %> } })

      repositoryMock.assertNotCalled('exists')
      repositoryMock.assertCalled('save')
    })
  })
<%_ }) _%>
})
