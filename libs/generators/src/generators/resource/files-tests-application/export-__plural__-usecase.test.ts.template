import { Export<%- pluralClassName %>UseCase } from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/use-cases/export-<%- plural %>-usecase.service'
import search<%- className %>Config from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/config/search-<%- fileName %>-config'
import { ExportTooLargeError } from '../../../../../src/contexts/shared/domain/errors'
import { <%- className %>Mother } from '../../domain/mothers/<%- fileName %>.mother'
import { <%- className %>RepositoryMock } from '../../mocks/<%- fileName %>.repository.mock'

describe('Export<%- pluralClassName %>UseCase', () => {
  let repositoryMock: <%- className %>RepositoryMock
  let useCase: Export<%- pluralClassName %>UseCase

  beforeEach(() => {
    repositoryMock = new <%- className %>RepositoryMock()
    useCase = new Export<%- pluralClassName %>UseCase(repositoryMock)
  })

  it('returns every matching <%- fileName %> as primitives, without paginating', async () => {
    const <%- plural %> = <%- className %>Mother.randomList(3)
    repositoryMock.givenCount(3)
    repositoryMock.givenMatching(<%- plural %>)

    const rows = await useCase.invoke({})

    expect(rows).toHaveLength(3)
    expect(rows[0]).toEqual(<%- plural %>[0].toPrimitives())
  })

  it('checks the count first and throws ExportTooLargeError without loading rows', async () => {
    useCase = new Export<%- pluralClassName %>UseCase(repositoryMock, 2)
    repositoryMock.givenCount(3)

    await expect(useCase.invoke({})).rejects.toBeInstanceOf(ExportTooLargeError)
    repositoryMock.assertNotCalled('matching')
  })

  it('builds the criteria with the search over the module searchable fields', async () => {
    repositoryMock.givenCount(0)
    repositoryMock.givenMatching([])

    await useCase.invoke({ search: 'anything' })

    const criteria = repositoryMock.matchingCriteria()
    expect(criteria.hasSearch()).toBe(true)
    expect(criteria.search?.fields).toEqual(search<%- className %>Config.searchableFields)
  })
})
