import { Search<%- className %>sUseCase } from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/use-cases/search-<%- plural %>-usecase.service'
import search<%- className %>Config from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/config/search-<%- fileName %>-config'
import { OffsetInput } from '../../../../../src/contexts/shared/domain/query/criteria'
import { <%- className %>Mother } from '../../domain/mothers/<%- fileName %>.mother'
import { <%- className %>RepositoryMock } from '../../mocks/<%- fileName %>.repository.mock'

describe('Search<%- className %>sUseCase', () => {
  let repositoryMock: <%- className %>RepositoryMock
  let useCase: Search<%- className %>sUseCase

  const baseInput: OffsetInput = { page: 1, pageSize: 10 }

  beforeEach(() => {
    repositoryMock = new <%- className %>RepositoryMock()
    useCase = new Search<%- className %>sUseCase(repositoryMock)
  })

  it('returns a paginated list with correct metadata', async () => {
    const <%- plural %> = <%- className %>Mother.randomList(3)
    repositoryMock.givenMatching(<%- plural %>)
    repositoryMock.givenCount(3)

    const result = await useCase.invoke(baseInput)

    expect(result.total).toBe(3)
    expect(result.page).toBe(1)
    expect(result.pageSize).toBe(10)
    expect(result.totalPages).toBe(1)
    expect(result.items).toHaveLength(3)
    expect(result.items[0]).toEqual(<%- plural %>[0].toPrimitives())
  })

  it('calculates totalPages across multiple pages', async () => {
    repositoryMock.givenMatching(<%- className %>Mother.randomList(10))
    repositoryMock.givenCount(25)

    const result = await useCase.invoke({ page: 2, pageSize: 10 })

    expect(result.total).toBe(25)
    expect(result.totalPages).toBe(3)
  })

  it('builds the criteria with the search over the module searchable fields', async () => {
    repositoryMock.givenMatching([])
    repositoryMock.givenCount(0)

    await useCase.invoke({ ...baseInput, search: 'anything' })

    const criteria = repositoryMock.matchingCriteria()
    expect(criteria.hasSearch()).toBe(true)
    expect(criteria.search?.fields).toEqual(search<%- className %>Config.searchableFields)
  })
})
