import { Aggregate<%- pluralClassName %>UseCase } from '../../../../../src/contexts/<%- context %>/modules/<%- plural %>/application/use-cases/aggregate-<%- plural %>-usecase.service'
import { InvalidArgumentError } from '../../../../../src/contexts/shared/domain/errors'
import { <%- className %>RepositoryMock } from '../../mocks/<%- fileName %>.repository.mock'

/**
 * El caso de uso es la FRONTERA DE CONFIANZA de la agregación (spec 71): el nombre del campo llega
 * por HTTP y acaba interpolado en la consulta. Lo que se prueba aquí no es la aritmética —eso es
 * del repositorio— sino que nada fuera de la lista blanca llega abajo.
 */
describe('Aggregate<%- pluralClassName %>UseCase', () => {
  let repositoryMock: <%- className %>RepositoryMock
  let useCase: Aggregate<%- pluralClassName %>UseCase

  beforeEach(() => {
    repositoryMock = new <%- className %>RepositoryMock()
    useCase = new Aggregate<%- pluralClassName %>UseCase(repositoryMock)
  })
<%_ if (aggregateProbe) { _%>

  it('devuelve el valor que da el repositorio', async () => {
    repositoryMock.givenAggregate(42)

    const result = await useCase.invoke({ op: 'sum', field: '<%- aggregateProbe %>' })

    expect(result).toEqual({ value: 42 })
  })

  it('propaga el «no hay dato» sin convertirlo en cero', async () => {
    repositoryMock.givenAggregate(null)

    const result = await useCase.invoke({ op: 'avg', field: '<%- aggregateProbe %>' })

    expect(result).toEqual({ value: null })
  })

  it('rechaza un campo que no está en la lista blanca, sin bajar al repositorio', async () => {
    await expect(useCase.invoke({ op: 'sum', field: 'notAField' })).rejects.toThrow(InvalidArgumentError)
  })

  it('rechaza una inyección por el nombre del campo', async () => {
    await expect(
      useCase.invoke({ op: 'sum', field: '<%- aggregateProbe %>) FROM users; --' })
    ).rejects.toThrow(InvalidArgumentError)
  })

  it('rechaza una operación que no existe', async () => {
    await expect(useCase.invoke({ op: 'median', field: '<%- aggregateProbe %>' })).rejects.toThrow(
      InvalidArgumentError
    )
  })
<%_ } _%>
<%_ if (aggregateDateProbe) { _%>

  it('rechaza sumar o promediar una fecha: no es una pregunta con respuesta', async () => {
    await expect(useCase.invoke({ op: 'sum', field: '<%- aggregateDateProbe %>' })).rejects.toThrow(
      InvalidArgumentError
    )
    await expect(useCase.invoke({ op: 'avg', field: '<%- aggregateDateProbe %>' })).rejects.toThrow(
      InvalidArgumentError
    )
  })

  it('acepta el máximo de una fecha: «la última visita» sí es una pregunta', async () => {
    repositoryMock.givenAggregate(1)

    await expect(useCase.invoke({ op: 'max', field: '<%- aggregateDateProbe %>' })).resolves.toEqual({ value: 1 })
  })
<%_ } _%>
})
