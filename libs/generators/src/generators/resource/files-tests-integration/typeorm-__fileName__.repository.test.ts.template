import { v7 as uuidv7 } from 'uuid'
import { moduleFixture } from '../jest.setup.integration'
import { TypeOrm<%- className %>Repository } from '../../../src/contexts/<%- context %>/modules/<%- plural %>/infrastructure/persistence/typeorm/typeorm-<%- fileName %>.repository'
import { <%- className %>WithIdSpecification } from '../../../src/contexts/<%- context %>/modules/<%- plural %>/domain/specifications/<%- fileName %>-with-id.specification'
import { ConcurrencyConflictError } from '../../../src/contexts/shared/domain/errors'
import { <%- className %>Id } from '../../../src/contexts/shared/domain/value-objects/<%- plural %>/<%- fileName %>-id.vo'
<%_ if (softContract) { _%>
import { DeleteOperationId } from '../../../src/contexts/shared/domain/value-objects/delete-operation-id.vo'
<%_ } _%>
<%_ domainTests.uniqueFinders.forEach(f => { _%>
<%_ if (f.shared) { _%>
import { <%- f.voName %> } from '../../../src/contexts/<%- context %>/shared/domain/value-objects/<%- f.voFileName %>.vo'
<%_ } else { _%>
import { <%- f.voName %> } from '../../../src/contexts/<%- context %>/modules/<%- plural %>/domain/value-objects/<%- f.voFileName %>.vo'
<%_ } _%>
<%_ }) _%>
import { <%- className %>Mother } from '../../modules/<%- plural %>/domain/mothers/<%- fileName %>.mother'

let repository: TypeOrm<%- className %>Repository

beforeAll(() => {
  repository = moduleFixture.get(TypeOrm<%- className %>Repository)
})

describe('TypeOrm<%- className %>Repository (integration)', () => {
  describe('register / get', () => {
    it('persists a new <%- fileName %> and reads it back', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()

      await repository.register(<%- propertyName %>)
      const found = await repository.get(<%- propertyName %>.id)

      expect(found?.toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
    })

    it('returns null for a non-existent id', async () => {
      const found = await repository.get(<%- className %>Id.create(uuidv7()))
      expect(found).toBeNull()
    })
  })

  describe('save — bloqueo optimista (spec 78)', () => {
    it('dos saves sobre la misma versión leída: el primero gana, el segundo choca con 409', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const firstReader = await repository.get(<%- propertyName %>.id)
      const secondReader = await repository.get(<%- propertyName %>.id)

      await repository.save(firstReader!)
      await expect(repository.save(secondReader!)).rejects.toThrow(ConcurrencyConflictError)

      const persisted = await repository.get(<%- propertyName %>.id)
      expect(persisted?.version).toBe(2)
    })
  })
<%_ domainTests.uniqueFinders.forEach(f => { _%>

  describe('<%- f.method %>', () => {
    it('finds a persisted <%- fileName %> by its <%- f.param %>', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const found = await repository.<%- f.method %>(<%- f.voName %>.create(<%- propertyName %>.toPrimitives().<%- f.param %><% if (f.nullable) { %> ?? ''<% } %>))

      expect(found?.toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
    })

    it('returns null when no <%- fileName %> has that <%- f.param %>', async () => {
      // los valores de la mother son aleatorios: este nunca se registró
      const unregistered = <%- className %>Mother.random()

      const found = await repository.<%- f.method %>(<%- f.voName %>.create(unregistered.toPrimitives().<%- f.param %><% if (f.nullable) { %> ?? ''<% } %>))

      expect(found).toBeNull()
    })
  })
<%_ }) _%>

  describe('matching / exists / count', () => {
    it('matching returns the <%- fileName %> selected by criteria', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const results = await repository.matching(<%- className %>WithIdSpecification.withId(<%- propertyName %>.id))

      expect(results).toHaveLength(1)
      expect(results[0].toPrimitives()).toEqual(<%- propertyName %>.toPrimitives())
    })

    it('exists / count reflect the persisted rows', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const spec = <%- className %>WithIdSpecification.withId(<%- propertyName %>.id)
      expect(await repository.exists(spec)).toBe(true)
      expect(await repository.count(spec)).toBe(1)

      const absent = <%- className %>WithIdSpecification.withId(<%- className %>Id.create(uuidv7()))
      expect(await repository.exists(absent)).toBe(false)
      expect(await repository.count(absent)).toBe(0)
    })
  })
<%_ if (aggregateProbe) { _%>

  describe('aggregate (spec 71)', () => {
    it('agrega el conjunto filtrado, y el vacío no responde lo mismo en todas las operaciones', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const spec = <%- className %>WithIdSpecification.withId(<%- propertyName %>.id)
      const value = <%- propertyName %>.toPrimitives().<%- aggregateProbe %>

      expect(await repository.aggregate(spec, 'sum', '<%- aggregateProbe %>')).toBe(value)
      expect(await repository.aggregate(spec, 'avg', '<%- aggregateProbe %>')).toBe(value)
      expect(await repository.aggregate(spec, 'max', '<%- aggregateProbe %>')).toBe(value)
      expect(await repository.aggregate(spec, 'min', '<%- aggregateProbe %>')).toBe(value)
      expect(await repository.aggregate(spec, 'distinct', '<%- aggregateProbe %>')).toBe(1)

      const absent = <%- className %>WithIdSpecification.withId(<%- className %>Id.create(uuidv7()))
      // la suma de nada es 0 y los distintos de nada son 0…
      expect(await repository.aggregate(absent, 'sum', '<%- aggregateProbe %>')).toBe(0)
      expect(await repository.aggregate(absent, 'distinct', '<%- aggregateProbe %>')).toBe(0)
      // …pero la media, el máximo y el mínimo de nada NO son 0: son «no hay dato»
      expect(await repository.aggregate(absent, 'avg', '<%- aggregateProbe %>')).toBeNull()
      expect(await repository.aggregate(absent, 'max', '<%- aggregateProbe %>')).toBeNull()
      expect(await repository.aggregate(absent, 'min', '<%- aggregateProbe %>')).toBeNull()
    })

    it('devuelve un número, no la cadena que el motor pueda dar por un numeric', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const sum = await repository.aggregate(
        <%- className %>WithIdSpecification.withId(<%- propertyName %>.id),
        'sum',
        '<%- aggregateProbe %>'
      )

      expect(typeof sum).toBe('number')
    })
  })
<%_ } _%>
<%_ if (groupProbe) { _%>

  describe('aggregateGrouped (spec 72)', () => {
    it('desglosa en UNA consulta, con su clave y su valor', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const groups = await repository.aggregateGrouped(
        <%- className %>WithIdSpecification.withId(<%- propertyName %>.id),
        { op: 'count', groupBy: '<%- groupProbe %>', limit: 50 }
      )

      expect(groups).toHaveLength(1)
      expect(groups[0].key).toBe(String(<%- propertyName %>.toPrimitives().<%- groupProbe %>))
      expect(groups[0].value).toBe(1)
    })

    it('un conjunto vacío no tiene grupos: no los inventa a 0', async () => {
      const groups = await repository.aggregateGrouped(
        <%- className %>WithIdSpecification.withId(<%- className %>Id.create(uuidv7())),
        { op: 'count', groupBy: '<%- groupProbe %>', limit: 50 }
      )

      expect(groups).toEqual([])
    })
<%_ if (aggregateDateProbe) { _%>

    it('agrupa por mes con la clave YYYY-MM', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      const groups = await repository.aggregateGrouped(
        <%- className %>WithIdSpecification.withId(<%- propertyName %>.id),
        { op: 'count', bucketField: '<%- aggregateDateProbe %>', limit: 50 }
      )

      // los meses vacíos los rellena el caso de uso: aquí solo vuelven los que tienen datos.
      // Un registro SIN fecha cae en el grupo '' (groupKeyOf(null)): también es contrato.
      for (const group of groups) {
        if (group.key !== '') expect(group.key).toMatch(/^\d{4}-\d{2}$/)
      }
    })
<%_ } _%>
  })
<%_ } _%>


<%_ if (app.removes) { _%>

  describe('remove', () => {
    it('removes a persisted <%- fileName %>', async () => {
      const <%- propertyName %> = <%- className %>Mother.random()
      await repository.register(<%- propertyName %>)

      await repository.remove(<%- propertyName %>.id<%- softContract ? ', DeleteOperationId.random()' : '' %>)

      expect(await repository.get(<%- propertyName %>.id)).toBeNull()
    })
  })
<%_ } _%>
})
