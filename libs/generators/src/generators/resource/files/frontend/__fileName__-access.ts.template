import { UserRoleEnum } from '<%- sharedDomainAlias %>'

/**
 * Roles por capacidad (spec 49), admin implícito — calculados de la matriz de accesos.
 * El backend emite exactamente los mismos roles en sus @Roles(...): una sola fuente.
 */
export const CAN_CREATE_ROLES: readonly UserRoleEnum[] = [<%- entry.createRoles %>]
export const CAN_EDIT_ROLES: readonly UserRoleEnum[] = [<%- entry.updateRoles %>]
export const CAN_DELETE_ROLES: readonly UserRoleEnum[] = [<%- entry.deleteRoles %>]
<%_ if (entry.transitions.length) { _%>

/** Roles por transición de la máquina de estados. */
export const TRANSITION_ROLES: Record<string, readonly UserRoleEnum[]> = {
<%_ entry.transitions.forEach((transition, index) => { _%>
  '<%- transition.verb %>': [<%- transition.roles %>]<%- index < entry.transitions.length - 1 ? ',' : '' %>
<%_ }) _%>
}
<%_ } _%>
