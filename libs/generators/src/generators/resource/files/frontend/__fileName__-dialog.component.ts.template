import { ChangeDetectionStrategy, Component, effect, inject, input, output } from '@angular/core'
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms'
import { HlmButtonImports } from '@spartan-ng/helm/button'
import { HlmDialogImports } from '@spartan-ng/helm/dialog'
import { HlmFieldImports } from '@spartan-ng/helm/field'
import { HlmInputImports } from '@spartan-ng/helm/input'
<%_ if (needsSelect) { _%>
import { HlmSelectImports } from '@spartan-ng/helm/select'
<%_ } _%>
import { <%- dialogSharedImports %> } from '<%- sharedDomainAlias %>'
<%_ formSections.forEach(section => { section.fields.forEach(f => { _%>
<%_ if (f.control === 'select' && f.optionsType) { _%>

const <%- f.name.replace(/([A-Z])/g, '_$1').toUpperCase() %>_LABELS: Record<string, string> = {
<%_ f.options.forEach(o => { _%>
  <%- o.value %>: '<%- o.label %>',
<%_ }) _%>
}
<%_ } _%>
<%_ }) }) _%>

export interface <%- className %>FormValue {
<%_ formValueLines.forEach(line => { _%>
  <%- line %>
<%_ }) _%>
}

@Component({
  selector: 'app-<%- fileName %>-dialog',
  imports: [
    ReactiveFormsModule,
    HlmDialogImports,
    HlmButtonImports,
    HlmFieldImports,
    HlmInputImports<%- needsSelect ? ',' : '' %>
<%_ if (needsSelect) { _%>
    HlmSelectImports
<%_ } _%>
  ],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <hlm-dialog-content *hlmDialogPortal="let ctx" class="max-h-[90vh] overflow-y-auto sm:max-w-2xl">
      <hlm-dialog-header>
        <h3 hlmDialogTitle>{{ <%- propertyName %>() ? '<%- ui.dialogEditTitle %>' : '<%- ui.createLabel %>' }}</h3>
        <p hlmDialogDescription>
          {{ <%- propertyName %>() ? '<%- ui.dialogEditDescription %>' : '<%- ui.dialogCreateDescription %>' }}
        </p>
      </hlm-dialog-header>
      <form class="space-y-6 py-4" [formGroup]="form" (ngSubmit)="save(ctx)">
<%_ formSections.forEach(section => { _%>
        <div>
          <h4 class="mb-3 text-sm font-semibold"><%- section.title %></h4>
<%_ if (section.grid) { _%>
          <div class="grid gap-4 sm:grid-cols-2">
<%_ } _%>
<%_ section.fields.forEach(f => { _%>
<%_ const pad = section.grid ? '            ' : '          ' _%>
<%_ if (f.control === 'select') { _%>
<%- pad %><hlm-field>
<%- pad %>  <label hlmFieldLabel for="<%- f.id %>"> <%- f.label %> </label>
<%- pad %>  <!-- itemToString: con el popover cerrado los items no están instanciados y el trigger
<%- pad %>       mostraría el valor crudo en modo edición en vez de la etiqueta. -->
<%- pad %>  <hlm-select formControlName="<%- f.name %>" [itemToString]="<%- f.name %>ToLabel">
<%- pad %>    <hlm-select-trigger buttonId="<%- f.id %>">
<%- pad %>      <hlm-select-value placeholder="<%- f.placeholder %>" />
<%- pad %>    </hlm-select-trigger>
<%- pad %>    <hlm-select-content *hlmSelectPortal>
<%_ f.options.forEach(o => { _%>
<%- pad %>      <hlm-select-item value="<%- o.value %>"><%- o.label %></hlm-select-item>
<%_ }) _%>
<%- pad %>    </hlm-select-content>
<%- pad %>  </hlm-select>
<%_ if (f.required) { _%>
<%- pad %>  <hlm-field-error>Obligatorio</hlm-field-error>
<%_ } _%>
<%- pad %></hlm-field>
<%_ } else if (f.control === 'textarea') { _%>
<%- pad %><hlm-field>
<%- pad %>  <label hlmFieldLabel for="<%- f.id %>"> <%- f.label %> </label>
<%- pad %>  <textarea id="<%- f.id %>" class="resize-none" hlmInput formControlName="<%- f.name %>" rows="<%- f.rows %>"></textarea>
<%- pad %></hlm-field>
<%_ } else { _%>
<%- pad %><hlm-field>
<%- pad %>  <label hlmFieldLabel for="<%- f.id %>"> <%- f.label %> </label>
<%- pad %>  <input id="<%- f.id %>" hlmInput formControlName="<%- f.name %>" />
<%_ if (f.required) { _%>
<%- pad %>  @if (form.controls.<%- f.name %>.touched && form.controls.<%- f.name %>.invalid) {
<%- pad %>    <hlm-field-error>Obligatorio</hlm-field-error>
<%- pad %>  }
<%_ } _%>
<%- pad %></hlm-field>
<%_ } _%>
<%_ }) _%>
<%_ if (section.grid) { _%>
          </div>
<%_ } _%>
        </div>

<%_ }) _%>
        <hlm-dialog-footer>
          <button type="button" hlmBtn variant="outline" (click)="ctx.close()">Cancelar</button>
          <button type="submit" [disabled]="form.invalid" hlmBtn>
            {{ <%- propertyName %>() ? 'Guardar' : 'Crear' }}
          </button>
        </hlm-dialog-footer>
      </form>
    </hlm-dialog-content>
  `
})
export class <%- className %>DialogComponent {
  private readonly _fb = inject(FormBuilder)

  readonly <%- propertyName %> = input<<%- dtoName %> | null>(null)
  readonly saved = output<<%- className %>FormValue>()
<%_ formSections.forEach(section => { section.fields.forEach(f => { _%>
<%_ if (f.control === 'select' && f.optionsType) { _%>

  protected readonly <%- f.name %>ToLabel = (value: unknown): string =>
    <%- f.name.replace(/([A-Z])/g, '_$1').toUpperCase() %>_LABELS[String(value)] ?? ''
<%_ } _%>
<%_ }) }) _%>

  readonly form = this._fb.nonNullable.group({
<%_ formGroupLines.forEach(line => { _%>
    <%- line %>,
<%_ }) _%>
  })

  constructor() {
    effect(() => {
      const <%- propertyName %> = this.<%- propertyName %>()
      if (<%- propertyName %>) {
        this.form.patchValue({
<%_ formPatchLines.forEach(line => { _%>
          <%- line %>,
<%_ }) _%>
        })
      }
    })
  }

  save(ctx: { close: () => void }): void {
    if (this.form.valid) {
      const raw = this.form.getRawValue()
      <%- savedEmitSrc %>
      ctx.close()
    }
  }
}
