import { <%- angularCoreImports %> } from '@angular/core'
<%_ if (features.view) { _%>
import { Router } from '@angular/router'
<%_ } _%>
import { provideIcons } from '@ng-icons/core'
import { <%- icons.join(', ') %> } from '@ng-icons/lucide'
<%_ if (features.edit || features.delete) { _%>
import { NotificationService } from '../../../../../../shared/components/ui/notification.service'
<%_ } _%>
<%_ if (features.delete) { _%>
import { AppConfirmDialog } from '../../../../../../shared/components/ui/confirm-dialog'
<%_ } _%>
<%_ if (features.edit) { _%>
import { AppDialog } from '../../../../../../shared/components/ui/dialog'
<%_ } _%>
import { <%- dtoName %>, ExportFormat } from '<%- sharedDomainAlias %>'
<%_ if (features.edit || features.delete) { _%>
import { AuthService } from '../../../../../../core/services/auth.service'
<%_ } _%>
import { <%- className %>Service, OffsetPaginatedOutput } from '../../../../../../core/services/<%- fileName %>.service'
<%_ if (valueMapImports.length) { _%>
import { <%- valueMapImports.join(', ') %> } from './<%- fileName %>-labels'
<%_ } _%>
<%_ if (features.edit) { _%>
import { generateId } from '../../../../../../shared/utils/uuid'
<%_ } _%>
import { navigationCameFrom } from '../../../../../../shared/utils/navigation'
import {
  ColumnDef,
  ColumnFilter,
  DataTable,
  SortOrder,
  TableAction
} from '../../../../../../shared/components/data-table'
import { downloadBlob } from '../../../../../../shared/utils/download-file'
<%_ if (features.edit) { _%>
import { <%- className %>DialogComponent, <%- className %>FormValue } from './<%- fileName %>-dialog.component'
<%_ } _%>

@Component({
  selector: 'app-<%- plural %>-list',
  imports: [DataTable<%- features.edit ? ', AppDialog' : '' %><%- features.delete ? ', AppConfirmDialog' : '' %><%- features.edit ? ', ' + className + 'DialogComponent' : '' %>],
  providers: [provideIcons({ <%- icons.join(', ') %> })],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="min-w-0 space-y-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight"><%- ui.title %></h1>
        <p class="text-muted-foreground"><%- ui.subtitle %></p>
      </div>

      @if (isLoading() && !hasData()) {
        <p class="text-muted-foreground py-12 text-center text-sm"><%- ui.loading %></p>
      } @else if (error()) {
        <p class="text-destructive py-12 text-center text-sm"><%- ui.error %></p>
      } @else if (total() === 0 && !hasActiveFilters() && !search()) {
        <p class="text-muted-foreground py-12 text-center text-sm"><%- ui.empty %></p>
      } @else {
        <app-data-table
          [columns]="columns"
          [data]="rows()"
          [serverSide]="true"
          [total]="total()"
          [page]="currentPage()"
          [pageSize]="pageSize()"
          [sortColumn]="sortColumn()"
          [sortDirection]="sortDirection()"
          [search]="search()"
          [loading]="isLoading()"
<%_ if (features.edit) { _%>
          [showCreate]="canWrite()"
          createLabel="<%- ui.createLabel %>"
<%_ } _%>
<%_ if (features.edit || features.delete) { _%>
          exportFilename="<%- ui.exportFilename %>"
          [actions]="actions()"
          (create)="openCreate()"
<%_ } else { _%>
          [actions]="actions"
          exportFilename="<%- ui.exportFilename %>"
<%_ } _%>
          (actionClick)="onAction($event)"
          (pageChange)="onPage($event)"
          (pageSizeChange)="onPageSize($event)"
          (sortChange)="onSort($event)"
          (searchChange)="onSearch($event)"
          (filtersChange)="onFilters($event)"
          (exportRequested)="onExport($event)"
        />
      }
    </div>
<%_ if (features.edit) { _%>

    <app-dialog [open]="dialogOpen()" (closed)="dialogOpen.set(false)">
      @if (dialogOpen()) {
        <app-<%- fileName %>-dialog
          [<%- propertyName %>]="editing<%- className %>()"
          (saved)="onSave($event)"
          (close)="dialogOpen.set(false)"
        />
      }
    </app-dialog>
<%_ } _%>
<%_ if (features.delete) { _%>

    <app-confirm-dialog
      [open]="deleteDialogOpen()"
      title="<%- ui.deleteTitle %>"
      [description]="deleteDescription()"
      (confirmed)="confirmDelete()"
      (closed)="deleteDialogOpen.set(false)"
    />
<%_ } _%>
  `
})
export class <%- className %>sListComponent {
  private readonly _service = inject(<%- className %>Service)
<%_ if (features.view) { _%>
  private readonly _router = inject(Router)
<%_ } _%>
<%_ if (features.edit || features.delete) { _%>
  protected readonly canWrite = inject(AuthService).canWrite
  private readonly _notify = inject(NotificationService)
<%_ } _%>

  constructor() {
    // El request vive en un servicio root y persiste entre navegaciones; se conserva solo
    // al volver del propio módulo (p.ej. del detalle) y se resetea al entrar desde fuera.
    if (!navigationCameFrom('<%- route %>')) {
      this._service.resetRequest()
    }
  }

  readonly isLoading = this._service.<%- plural %>.isLoading
  readonly error = this._service.<%- plural %>.error

  // resource() clears value() to undefined while reloading on a param change. Retain the last
  // loaded page so the DataTable is not unmounted (which would reset its internal currentPage).
  private readonly _loaded = linkedSignal<
    OffsetPaginatedOutput<<%- dtoName %>> | undefined,
    OffsetPaginatedOutput<<%- dtoName %>> | undefined
  >({
    source: () => this._service.<%- plural %>.value(),
    computation: (value, previous) => value ?? previous?.value
  })

  readonly rows = computed(() => (this._loaded()?.items ?? []) as unknown as Record<string, unknown>[])
  readonly total = computed(() => this._loaded()?.total ?? 0)
  readonly hasData = computed(() => this._loaded() !== undefined)
  readonly currentPage = computed(() => this._service.request().page)
  readonly pageSize = computed(() => this._service.request().pageSize)
  readonly sortColumn = computed(() => this._service.request().orders?.[0]?.orderBy ?? '')
  readonly sortDirection = computed(() => this._service.request().orders?.[0]?.orderType ?? 'asc')
  // With an active search, zero results must keep the table (and the search box) mounted.
  readonly search = computed(() => this._service.request().search ?? '')
  // Same for an active column filter: hiding the table would trap the user with an unclearable filter.
  readonly hasActiveFilters = computed(() => (this._service.request().filters?.length ?? 0) > 0)

<%_ if (features.edit) { _%>
  readonly dialogOpen = signal(false)
  readonly editing<%- className %> = signal<<%- dtoName %> | null>(null)
<%_ } _%>
<%_ if (features.delete) { _%>
  readonly deleting<%- className %> = signal<<%- dtoName %> | null>(null)
  readonly deleteDialogOpen = signal(false)
  readonly deleteDescription = computed(
    () =>
      `Se eliminará permanentemente <%- ui.deleteDescriptionSubject %> "${this.deleting<%- className %>()?.<%- deleteLabelField %> ?? ''}" y todos sus datos asociados. Esta acción no se puede deshacer.`
  )
<%_ } _%>

  readonly columns: ColumnDef[] = [
<%_ frontendColumns.forEach(col => { _%>
    <%- col %>,
<%_ }) _%>
  ]

<%_ if (!features.edit && !features.delete) { _%>
  readonly actions: TableAction[] = [{ icon: 'lucideEye', label: '<%- ui.viewLabel %>', action: 'view' }]
<%_ } else if (features.view) { _%>
  // Editar solo para quien puede escribir: el backend responde 403 al viewer, así que ofrecer la
  // acción solo llevaría a un error.
  readonly actions = computed<TableAction[]>(() => [
    { icon: 'lucideEye', label: '<%- ui.viewLabel %>', action: 'view' },
    ...(this.canWrite() ? [{ icon: 'lucidePencil', label: 'Editar', action: 'edit' } as TableAction] : [])
  ])
<%_ } else { _%>
  // Un viewer no ve ninguna: son escrituras que el backend rechazaría con 403.
  readonly actions = computed<TableAction[]>(() =>
    this.canWrite()
      ? [
          { icon: 'lucidePencil', label: 'Editar', action: 'edit' },
<%_ if (features.delete) { _%>
          { icon: 'lucideTrash2', label: 'Eliminar', action: 'delete', variant: 'ghost' }
<%_ } _%>
        ]
      : []
  )
<%_ } _%>

  onPage(page: number): void {
    this._service.request.update(r => ({ ...r, page }))
  }

  onPageSize(pageSize: number): void {
    this._service.request.update(r => ({ ...r, pageSize, page: 1 }))
  }

  async onExport(format: ExportFormat): Promise<void> {
    const { blob, filename } = await this._service.export(format)
    downloadBlob(blob, filename)
  }

  onSort(sort: SortOrder | null): void {
    this._service.request.update(r => ({ ...r, orders: sort ? [sort] : undefined, page: 1 }))
  }

  onSearch(search: string): void {
    this._service.request.update(r => ({ ...r, search: search || undefined, page: 1 }))
  }

  onFilters(filters: ColumnFilter[]): void {
    this._service.request.update(r => ({ ...r, filters, page: 1 }))
  }

<%_ if (features.edit) { _%>
  openCreate(): void {
    this.editing<%- className %>.set(null)
    this.dialogOpen.set(true)
  }

<%_ } _%>
<%_ if (!features.edit && !features.delete) { _%>
  onAction(event: { action: string; row: Record<string, unknown> }): void {
    if (event.action !== 'view') {
      return
    }
    const <%- propertyName %> = event.row as unknown as <%- dtoName %>
    this._router.navigate(['<%- route %>', <%- propertyName %>.id])
  }
<%_ } else { _%>
  onAction(event: { action: string; row: Record<string, unknown> }): void {
    const <%- propertyName %> = event.row as unknown as <%- dtoName %>
<%_ if (features.view) { _%>
    if (event.action === 'view') {
      this._router.navigate(['<%- route %>', <%- propertyName %>.id])
    } else if (event.action === 'edit') {
<%_ } else { _%>
    if (event.action === 'edit') {
<%_ } _%>
      this.editing<%- className %>.set(<%- propertyName %>)
      this.dialogOpen.set(true)
<%_ if (features.delete) { _%>
    } else if (event.action === 'delete') {
      this.deleting<%- className %>.set(<%- propertyName %>)
      this.deleteDialogOpen.set(true)
<%_ } _%>
    }
  }
<%_ } _%>
<%_ if (features.delete) { _%>

  async confirmDelete(): Promise<void> {
    const <%- propertyName %> = this.deleting<%- className %>()
    this.deleteDialogOpen.set(false)
    if (!<%- propertyName %>) {
      return
    }
    try {
      await this._service.remove(<%- propertyName %>.id)
      this._notify.success('<%- ui.toastDeleted %>')
    } catch {
      this._notify.error('<%- ui.toastDeleteError %>')
    }
  }
<%_ } _%>

<%_ if (features.edit) { _%>
  async onSave(value: <%- className %>FormValue): Promise<void> {
    const editing = this.editing<%- className %>()
    this.dialogOpen.set(false)
    try {
      if (editing) {
        await this._service.update(editing.id, value)
        this._notify.success('<%- ui.toastUpdated %>')
      } else {
        await this._service.create({ id: generateId(), ...value })
        this._notify.success('<%- ui.toastCreated %>')
      }
    } catch {
      this._notify.error(editing ? '<%- ui.toastUpdateError %>' : '<%- ui.toastCreateError %>')
    }
  }
<%_ } _%>

  // @ai:begin list-extra — acciones, columnas o estados a medida
  // @ai:end
}
