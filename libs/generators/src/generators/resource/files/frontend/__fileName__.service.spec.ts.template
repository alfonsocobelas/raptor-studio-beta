<%_ if (features.delete) { _%>

  it('remove deletes <%- api %>/:id and reloads the list', async () => {
    const reload = vi.spyOn(service.<%- plural %>, 'reload')
    const id = '019eb713-19bb-7000-8000-000000000010'

    await service.remove(id)

    expect(httpDelete).toHaveBeenCalledWith(`<%- api %>/${id}`)
    expect(reload).toHaveBeenCalledOnce()
  })
<%_ } _%>
})
<%_ } _%>

describe('<%- className %>Service — export', () => {
  let service: <%- className %>Service

  const configure = (disposition: string | null) => {
    const blob = new Blob(['data'], { type: 'text/csv' })
    const httpGet = vi
      .fn()
      .mockReturnValue(
        of({ body: blob, headers: { get: (name: string) => (name === 'Content-Disposition' ? disposition : null) } })
      )
    TestBed.configureTestingModule({
      providers: [
        provideZonelessChangeDetection(),
        { provide: HttpClient, useValue: { get: httpGet, post: vi.fn(), put: vi.fn(), delete: vi.fn() } },
        <%- className %>Service
      ]
    })
    service = TestBed.inject(<%- className %>Service)
    return { blob, httpGet }
  }

  it('exports as a blob with the current filters and orders, returning the filename from the header', async () => {
    const { blob, httpGet } = configure('attachment; filename="<%- ui.exportFilename %>-20260707.csv"')
    service.request.set({
      page: 1,
      pageSize: 10,
      filters: [{ column: '<%- test.filterSamples[0].field %>', columnLabel: '<%- test.filterSamples[0].label %>', operator: '<%- test.filterSamples[0].operator %>', value: <%- test.filterSamples[0].value %> }],
      orders: [{ orderBy: '<%- test.sortField %>', orderType: 'asc' }]
    })

    const result = await service.export('csv')

    expect(httpGet).toHaveBeenLastCalledWith('<%- api %>/export', {
      params: {
        format: 'csv',
        filters: JSON.stringify([{ field: '<%- test.filterSamples[0].field %>', operator: '<%- test.filterSamples[0].operator %>', value: <%- test.filterSamples[0].value %> }]),
        orders: JSON.stringify([{ orderBy: '<%- test.sortField %>', orderType: 'asc' }])
      },
      responseType: 'blob',
      observe: 'response'
    })
    expect(result.blob).toBe(blob)
    expect(result.filename).toBe('<%- ui.exportFilename %>-20260707.csv')
  })

  it('includes the active search in the export params', async () => {
    const { httpGet } = configure('attachment; filename="<%- ui.exportFilename %>-20260707.csv"')
    service.request.set({ page: 1, pageSize: 10, search: 'acme' })

    await service.export('csv')

    expect(httpGet).toHaveBeenLastCalledWith('<%- api %>/export', {
      params: { format: 'csv', search: 'acme' },
      responseType: 'blob',
      observe: 'response'
    })
  })

  it('falls back to a default filename when the header is missing', async () => {
    configure(null)

    const result = await service.export('xlsx')

    expect(result.filename).toBe('<%- ui.exportFilename %>.xlsx')
  })
})
