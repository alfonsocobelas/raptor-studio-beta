import { HttpClient } from '@angular/common/http'
import { provideZonelessChangeDetection } from '@angular/core'
import { TestBed } from '@angular/core/testing'
<%_ if (test.enumImports && features.edit) { _%>
import { <%- test.enumImports %> } from '<%- sharedDomainAlias %>'
<%_ } _%>
import { of } from 'rxjs'
import { vi } from 'vitest'
import { <%- className %>Service } from './<%- fileName %>.service'
import { <%- test.mockConst %> } from './mocks/<%- fileName %>.mock'

const tick = () => TestBed.flushEffects()

describe('<%- className %>Service — listado', () => {
  let service: <%- className %>Service
  let httpGet: ReturnType<typeof vi.fn>

  // otras vistas pueden pedir en el mismo tick, así que la última llamada global no
  // siempre es la del listado: se mira la última hecha a SU url
  const lastListCall = () => httpGet.mock.calls.filter(([url]) => url === '<%- api %>').at(-1)

  beforeEach(() => {
    httpGet = vi.fn().mockReturnValue(of(<%- test.mockConst %>))
    TestBed.configureTestingModule({
      providers: [
        provideZonelessChangeDetection(),
        { provide: HttpClient, useValue: { get: httpGet, post: vi.fn(), put: vi.fn(), delete: vi.fn() } },
        <%- className %>Service
      ]
    })
    service = TestBed.inject(<%- className %>Service)
  })

  it('initializes request signal with page 1 and pageSize 10', () => {
    expect(service.request()).toEqual({ page: 1, pageSize: 10 })
  })

  it('resetRequest restores the default request', () => {
    service.request.set({ page: 3, pageSize: 50, search: 'acme' })

    service.resetRequest()

    expect(service.request()).toEqual({ page: 1, pageSize: 10 })
  })

  it('calls GET <%- api %> with page and pageSize params on load', () => {
    tick()
    expect(httpGet).toHaveBeenCalledWith('<%- api %>', {
      params: { page: '1', pageSize: '10' }
    })
  })

  it('adds an orders param (JSON) when orders are set', () => {
    const orders = [{ orderBy: '<%- test.sortField %>', orderType: 'asc' as const }]
    service.request.set({ page: 1, pageSize: 10, orders })
    tick()

    expect(lastListCall()).toEqual([
      '<%- api %>',
      { params: { page: '1', pageSize: '10', orders: JSON.stringify(orders) } }
    ])
  })

  it('exposes paginated response after load', async () => {
    tick()
    await Promise.resolve()
    await Promise.resolve()
    expect(service.<%- plural %>.value()).toEqual(<%- test.mockConst %>)
  })

  it('adds the search param when a term is set, and omits it when empty', () => {
    service.request.set({ page: 1, pageSize: 10, search: 'acme' })
    tick()

    expect(lastListCall()).toEqual(['<%- api %>', { params: { page: '1', pageSize: '10', search: 'acme' } }])

    service.request.set({ page: 1, pageSize: 10, search: undefined })
    tick()

    expect(lastListCall()).toEqual(['<%- api %>', { params: { page: '1', pageSize: '10' } }])
  })

  it('serializes column filters to the filters param, dropping the columnLabel', () => {
    const filters = [
<%_ test.filterSamples.forEach((f, i) => { _%>
      { column: '<%- f.field %>', columnLabel: '<%- f.label %>', operator: '<%- f.operator %>', value: <%- f.value %> }<%- i < test.filterSamples.length - 1 ? ',' : '' %>
<%_ }) _%>
    ]
    service.request.set({ page: 1, pageSize: 10, filters })
    tick()

    expect(lastListCall()).toEqual([
      '<%- api %>',
      {
        params: {
          page: '1',
          pageSize: '10',
          filters: JSON.stringify([
<%_ test.filterSamples.forEach((f, i) => { _%>
            { field: '<%- f.field %>', operator: '<%- f.operator %>', value: <%- f.value %> }<%- i < test.filterSamples.length - 1 ? ',' : '' %>
<%_ }) _%>
          ])
        }
      }
    ])
  })
})
