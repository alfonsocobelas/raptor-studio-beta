    httpPut = vi.fn().mockReturnValue(of(undefined))
    httpDelete = vi.fn().mockReturnValue(of(undefined))
    TestBed.configureTestingModule({
      providers: [
        provideZonelessChangeDetection(),
        {
          provide: HttpClient,
          useValue: {
            get: vi.fn().mockReturnValue(of(<%- test.mockConst %>)),
            post: httpPost,
            put: httpPut,
            delete: httpDelete
          }
        },
        <%- className %>Service
      ]
    })
    service = TestBed.inject(<%- className %>Service)
  })
<%_ if (features.edit) { _%>

  it('create posts to <%- api %> and reloads the list', async () => {
