    await service.create({
<%_ test.createSampleLines.forEach(line => { _%>
      <%- line %>
<%_ }) _%>
    })

    expect(httpPost).toHaveBeenCalledOnce()
    expect(reload).toHaveBeenCalledOnce()
  })

  it('update puts to <%- api %>/:id and reloads the list', async () => {
    const reload = vi.spyOn(service.<%- plural %>, 'reload')
    const id = '019eb713-19bb-7000-8000-000000000010'

    await service.update(id, <%- test.updateSampleSrc %>)

