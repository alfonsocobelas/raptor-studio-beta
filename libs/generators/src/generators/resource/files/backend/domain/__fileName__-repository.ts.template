<%_ if (domainTests.emit) { _%>
<%_ domainTests.portImports.forEach(line => { _%>
<%- line %>
<%_ }) _%>

export abstract class <%- className %>Repository {
  abstract register(<%- propertyName %>: <%- className %>): Promise<void>
  abstract save(<%- propertyName %>: <%- className %>): Promise<void>
<%_ if (app.removes) { _%>
  abstract remove(<%- propertyName %>Id: <%- className %>Id<%- softContract ? ', op: DeleteOperationId' : '' %>): Promise<void>
<%_ } _%>
<%_ dragged.forEach(d => { _%>
  abstract <%- d.method %>(parentIds: string[], op: DeleteOperationId): Promise<string[]>
<%_ }) _%>
  abstract get(<%- propertyName %>Id: <%- className %>Id): Promise<Nullable<<%- className %>>>
  abstract matching(criteria: Criteria): Promise<<%- className %>[]>
<%_ domainTests.uniqueFinders.forEach(f => { _%>
  abstract <%- f.method %>(<%- f.param %>: <%- f.voName %>): Promise<Nullable<<%- className %>>>
<%_ }) _%>
  abstract exists(criteria: Criteria): Promise<boolean>
  abstract count(criteria: Criteria): Promise<number>
  /** Una agregación del conjunto filtrado (spec 71). `null` = no hay dato, que no es lo mismo que 0. */
  abstract aggregate(criteria: Criteria, op: AggregateOp, field: string): Promise<number | null>
  /** El desglose de una agregación, en una sola consulta (spec 72). */
  abstract aggregateGrouped(criteria: Criteria, spec: GroupedSpec): Promise<AggregateGroup[]>
  // @ai:begin port-extra — finders no derivables (sync, agregaciones)
  // @ai:end
}
<%_ } _%>
