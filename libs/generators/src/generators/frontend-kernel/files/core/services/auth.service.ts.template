import { HttpClient } from '@angular/common/http'
import { Injectable, computed, inject, signal } from '@angular/core'
import {
  AcceptInvitationDto,
  CurrentUserDto,
  ForgotPasswordDto,
  LoginDto,
  ResetPasswordDto,
  UserRoleEnum
} from '<%- sharedDomainAlias %>'
import { catchError, firstValueFrom, of } from 'rxjs'
import { API_PREFIX } from '../http/api.constants'

@Injectable({ providedIn: 'root' })
export class AuthService {
  private readonly _http = inject(HttpClient)

  private readonly _currentUser = signal<CurrentUserDto | null>(null)
  private readonly _loaded = signal(false)

  readonly currentUser = this._currentUser.asReadonly()
  readonly isAuthenticated = computed(() => this._currentUser() != null)

  /**
   * Whether the current user may write business data. The viewer role is a read-only auditor.
   *
   * Roles are listed rather than negated (`!== VIEWER`) on purpose: a fourth role added later
   * should not silently inherit write access, mirroring how the backend declares @Roles per endpoint.
   */
  readonly canWrite = computed(() => {
    const role = this._currentUser()?.role
    return role === UserRoleEnum.ADMIN || role === UserRoleEnum.USER
  })

  /** La gestión de usuarios es solo de administradores: la nav se oculta al resto (el backend ya responde 403). */
  readonly isAdmin = computed(() => this._currentUser()?.role === UserRoleEnum.ADMIN)

  readonly userInitials = computed(() => {
    const user = this._currentUser()
    if (!user) {
      return '??'
    }
    return user.name
      .split(' ')
      .map(part => part[0])
      .join('')
      .substring(0, 2)
      .toUpperCase()
  })

  /** Resolves the current user from the session cookie. Called once at app bootstrap. */
  /** Punto de extensión: permite a un AuthService alternativo fijar el usuario. */
  protected setCurrentUser(user: CurrentUserDto | null): void {
    this._currentUser.set(user)
    this._loaded.set(true)
  }

  async loadCurrentUser(): Promise<CurrentUserDto | null> {
    const user = await firstValueFrom(
      this._http.get<CurrentUserDto>(`${API_PREFIX}/auth/me`).pipe(catchError(() => of(null)))
    )
    this._currentUser.set(user)
    this._loaded.set(true)
    return user
  }

  /** Returns the cached user, loading it once if bootstrap has not run yet. */
  async ensureLoaded(): Promise<CurrentUserDto | null> {
    if (this._loaded()) {
      return this._currentUser()
    }
    return this.loadCurrentUser()
  }

  async login(dto: LoginDto): Promise<CurrentUserDto> {
    const user = await firstValueFrom(this._http.post<CurrentUserDto>(`${API_PREFIX}/auth/login`, dto))
    this._currentUser.set(user)
    this._loaded.set(true)
    return user
  }

  async logout(): Promise<void> {
    await firstValueFrom(this._http.post<void>(`${API_PREFIX}/auth/logout`, {}))
    this._currentUser.set(null)
  }

  acceptInvitation(dto: AcceptInvitationDto): Promise<void> {
    return firstValueFrom(this._http.post<void>(`${API_PREFIX}/auth/accept-invitation`, dto))
  }

  requestReset(dto: ForgotPasswordDto): Promise<void> {
    return firstValueFrom(this._http.post<void>(`${API_PREFIX}/auth/forgot-password`, dto))
  }

  resetPassword(dto: ResetPasswordDto): Promise<void> {
    return firstValueFrom(this._http.post<void>(`${API_PREFIX}/auth/reset-password`, dto))
  }
}
