@layer theme, base, components, utilities;
@import 'tailwindcss/theme.css' layer(theme);
@import 'tailwindcss/preflight.css' layer(base);
@import 'tailwindcss/utilities.css';

@import '@spartan-ng/brain/hlm-tailwind-preset.css';
<%_ if (fontPackage) { _%>
/* La fuente del tema, self-hosted: los ficheros viajan con la app, sin CDNs. */
@import '<%= fontPackage %>';
<%_ } _%>

:root .<%= themeClass %> {
  color-scheme: light;

  --font-sans:
<%_ if (fontFamily) { _%>
    '<%= fontFamily %>',
<%_ } _%>
    -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif,
    'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';

  --radius: <%= radius %>;
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
<%= lightTokens %>
<%_ if (designTokens) { _%>

<%- designTokens %>
<%_ } _%>
}

:root.dark .<%= themeClass %> {
  color-scheme: dark;

<%= darkTokens %>
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    /* La letra del tema (y la que la piel pise) vive en el bloque :root .theme-x, que está en
       el <body>. La preflight de Tailwind resuelve la suya en <html>, fuera de ese bloque, así
       que sin esta línea --font-sans no lo leía NADIE y las tres pieles salían con la pila del
       sistema (medido en navegador, 2026-08-25). */
    font-family: var(--font-sans);
  }
  /* La preflight de Tailwind v4 dejó los botones con la flecha del puntero. En pantallas de
     tablero —conmutadores, celdas, pastillas— eso se lee como UI muerta: lo que no cambia
     bajo la mano parece que no se pulsa. Se devuelve la mano a lo vivo y solo a lo vivo:
     deshabilitado sigue con la flecha, que es justamente la señal de «esto no se toca». */
  button:not(:disabled),
  [role='button']:not([aria-disabled='true']) {
    cursor: pointer;
  }
}
<%_ if (designCss) { _%>
<%- designCss %>
<%_ } _%>
