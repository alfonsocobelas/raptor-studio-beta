{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "node",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@app/shared/domain": ["libs/shared/domain/src/index.ts"],
      "@app/backend/*": ["libs/backend/src/*"],
      "@app/frontend/*": ["libs/frontend/src/*"]
    }
  }
}
