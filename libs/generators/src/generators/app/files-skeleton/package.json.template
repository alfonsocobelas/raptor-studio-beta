{
  "name": "app",
  "private": true,
  "scripts": {
    "start": "ts-node -T -r tsconfig-paths/register apps/backend-api/src/main.ts",
    "seed": "ts-node -T -r tsconfig-paths/register libs/backend/src/seed.ts",
    "web": "ng serve --proxy-config apps/frontend-app/proxy.conf.json --port 4321",
    "web:build": "ng build",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:add": "nx g @spartan-ng/cli:ui",
    "lint:ui-boundaries": "! grep -rn --include='*.ts' -E '@spartan-ng|@angular/material' libs/frontend/src/domains libs/frontend/src/core || (echo '\u2717 Las pantallas importan la librer\u00eda de componentes: usa los contratos de shared/components/ui (ADR-003)' && exit 1)",
    "test": "NODE_ENV=test jest --selectProjects unit",
    "test:front": "vitest run",
    "test:integration": "NODE_ENV=test jest --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@angular/cdk": "21.2.6",
