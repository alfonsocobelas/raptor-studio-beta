<% if (needsNullable) { -%>
import { Nullable } from '../../../../shared/domain/types'
<% } -%>
import { DateValueObject } from '../../../../shared/domain/value-objects/date-value-object'

export class <%= className %> extends DateValueObject {
  protected static override fieldName = '<%= fieldName %>'

  private constructor(value: Date) {
    super(value)
  }

  static create(value: Date): <%= className %> {
    this.ensureIsValidDate(value)
    return new <%= className %>(value)
  }
<% if (hasUnset) { -%>

  static unset(): Nullable<<%= className %>> {
    return null
  }
<% } -%>
}
