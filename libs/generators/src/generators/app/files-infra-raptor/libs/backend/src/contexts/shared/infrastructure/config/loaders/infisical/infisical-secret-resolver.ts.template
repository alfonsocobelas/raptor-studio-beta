import { SecretResolutionError } from '../../../../domain/errors'

const VAULT_PREFIX = 'vault.'
const DEFAULT_SITE_URL = 'https://app.infisical.com'

/**
 * Minimal contract needed to read secrets. The REST reader below satisfies it, so tests
 * can inject a fake without touching HTTP.
 */
export interface SecretsReader {
  fetchSecret(name: string): Promise<string | undefined>
}

/** True when any (possibly nested) value is a `vault.*` placeholder. */
export function containsVaultReferences(value: unknown): boolean {
  if (typeof value === 'string') {
    return value.startsWith(VAULT_PREFIX)
  }

  if (Array.isArray(value)) {
    return value.some(containsVaultReferences)
  }

  if (value !== null && typeof value === 'object') {
    return Object.values(value).some(containsVaultReferences)
  }

  return false
}

/**
 * Deep-clones `config`, replacing every `vault.*` string with its Infisical secret value.
 * Non-vault values are returned untouched.
 */
export async function resolveSecrets<T>(config: T, reader: SecretsReader): Promise<T> {
  if (typeof config === 'string' && config.startsWith(VAULT_PREFIX)) {
    return (await getSecretValue(config, reader)) as unknown as T
  }

  if (Array.isArray(config)) {
    return (await Promise.all(config.map(item => resolveSecrets(item, reader)))) as unknown as T
  }

  if (config !== null && typeof config === 'object') {
    const resolved: Record<string, unknown> = {}

    for (const [key, value] of Object.entries(config)) {
      resolved[key] = await resolveSecrets(value, reader)
    }

    return resolved as T
  }

  return config
}

/**
 * Builds the real Infisical reader. The machine identity, the project and the environment
 * resolve from the standard environment (12-factor), mirroring AZURE_KEYVAULT_URL and
 * AWS_SECRETS_PREFIX. Point INFISICAL_SITE_URL at your own host to self-host later.
 *
 * No SDK on purpose: two REST calls over the platform's fetch keep the image small and
 * free of native binaries. The access token lives in memory, never on disk.
 */
export function createInfisicalReader(): SecretsReader {
  const siteUrl = (process.env['INFISICAL_SITE_URL'] ?? DEFAULT_SITE_URL).replace(/\/$/, '')
  const clientId = process.env['INFISICAL_CLIENT_ID']
  const clientSecret = process.env['INFISICAL_CLIENT_SECRET']
  const projectId = process.env['INFISICAL_PROJECT_ID']
  const environment = process.env['INFISICAL_ENV'] ?? 'prod'

  let token: Promise<string> | undefined

  const login = async (): Promise<string> => {
    const response = await fetch(`${siteUrl}/api/v1/auth/universal-auth/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ clientId, clientSecret })
    })
    if (!response.ok) {
      // The status is the whole message on purpose: the body may echo the credentials back.
      throw new SecretResolutionError('Infisical rejected the machine identity login', response.status)
    }
    const body = (await response.json()) as { accessToken?: string }
    if (!body.accessToken) {
      throw new SecretResolutionError('Infisical login returned no access token')
    }
    return body.accessToken
  }

  return {
    async fetchSecret(name: string): Promise<string | undefined> {
      if (!clientId || !clientSecret) {
        throw new SecretResolutionError('Missing machine identity: set INFISICAL_CLIENT_ID and INFISICAL_CLIENT_SECRET')
      }
      if (!projectId) {
        throw new SecretResolutionError('Missing project: set INFISICAL_PROJECT_ID')
      }
      // A failed login must not poison the cache: the next read retries from scratch.
      token ??= login().catch((error: unknown) => {
        token = undefined
        throw error
      })
      const accessToken = await token

      const query = new URLSearchParams({ workspaceId: projectId, environment })
      const response = await fetch(`${siteUrl}/api/v3/secrets/raw/${encodeURIComponent(name)}?${query}`, {
        headers: { Authorization: `Bearer ${accessToken}` }
      })
      if (response.status === 404) {
        return undefined
      }
      if (!response.ok) {
        throw new SecretResolutionError(`Failed to fetch secret [${name}] from Infisical`, response.status)
      }
      const body = (await response.json()) as { secret?: { secretValue?: string } }
      return body.secret?.secretValue
    }
  }
}

/**
 * Secret names flatten `vault.*` dots into underscores and go uppercase
 * (vault.typeorm.password → TYPEORM_PASSWORD): that is how Infisical names secrets in its
 * UI and its CLI, where Azure uses dashes and AWS slashes.
 */
async function getSecretValue(reference: string, reader: SecretsReader): Promise<string | undefined> {
  const secretName = reference.slice(VAULT_PREFIX.length).replace(/\./g, '_').toUpperCase()

  try {
    return await reader.fetchSecret(secretName)
  } catch (error) {
    if (error instanceof SecretResolutionError) {
      throw error
    }
    throw new SecretResolutionError(`Failed to fetch secret [${secretName}] from Infisical`, undefined, error)
  }
}
