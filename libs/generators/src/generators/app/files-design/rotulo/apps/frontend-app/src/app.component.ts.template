import { ChangeDetectionStrategy, Component, computed, inject } from '@angular/core'
import { NavigationEnd, Router, RouterLink, RouterLinkActive, RouterOutlet } from '@angular/router'
import { toSignal } from '@angular/core/rxjs-interop'
import { filter, map } from 'rxjs'
import { HlmToasterImports } from '@spartan-ng/helm/sonner'
import { NAV_ITEMS } from './nav'
import { ThemeService } from '@app/frontend/core/services/theme.service'

/** Rutas sin shell: las pantallas públicas de auth ocupan la página entera. */
const BARE_ROUTES = ['/login', '/forgot-password', '/reset-password', '/accept-invitation']

/**
 * Shell del preset «rotulo» (spec 69): la marca al frente.
 *
 * Banda de tinta arriba con el logotipo en el ACENTO DEL TEMA y la navegación DENTRO de la banda
 * — ni barra lateral ni pestañas de módulo aparte (eso es «suite»). Es la piel holgada de la
 * familia raptor: la banda pesa arriba y el contenido respira.
 *
 * La banda va en oklch literal, con su gemela bajo `.dark`, y es la única excepción declarada de
 * la familia: tiene que seguir siendo de tinta de noche, y ningún token del tema es oscuro en los
 * dos modos. El acento sí sale del tema.
 */
@Component({
  selector: 'app-root',
  imports: [RouterOutlet, RouterLink, RouterLinkActive, HlmToasterImports],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    @if (bare()) {
      <router-outlet />
    } @else {
      <div class="flex min-h-screen flex-col">
        <header
          class="app-shell-banner flex h-14 shrink-0 items-center gap-6 px-6"
          style="background: var(--banner-bg); color: var(--banner-fg)"
        >
          <div class="flex items-center gap-2.5">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-[7px] text-[11px] font-bold uppercase"
              style="background: var(--shell-accent); color: var(--banner-fg)"
              >{{ appTitle.slice(0, 2) }}</span
            >
            <span class="text-[15px] font-bold tracking-tight">{{ appTitle }}</span>
          </div>
          <nav class="app-shell-nav flex items-center gap-1">
            @for (item of navItems; track item.route) {
              <a
                [routerLink]="item.route"
                routerLinkActive="app-nav-active"
                class="rounded-lg px-3.5 py-2 text-[13px] font-semibold"
                style="color: var(--banner-fg-dim)"
              >
                {{ item.label }}
              </a>
            }
          </nav>
          <span class="flex-1"></span>
          <button
            type="button"
            class="text-[12.5px]"
            style="color: var(--banner-fg-dim)"
            (click)="theme.toggle()"
            [attr.aria-label]="theme.theme() === 'light' ? 'Activar tema oscuro' : 'Activar tema claro'"
            data-testid="theme-toggle"
          >
            {{ theme.theme() === 'light' ? '🌙' : '☀️' }}
          </button>
        </header>
        <main class="app-shell-main min-w-0 flex-1 p-8">
          <router-outlet />
        </main>
      </div>
    }
    <hlm-toaster />
  `,
  styles: `
    /* La activa se recorta sobre la banda con un velo de papel y el texto a plena luz: sobre
       tinta, un fondo de acento competiría con el logotipo. */
    .app-nav-active {
      background: var(--banner-active);
      color: var(--banner-fg) !important;
    }
  `
})
export class AppComponent {
  private readonly _router = inject(Router)

  protected readonly theme = inject(ThemeService)
  protected readonly appTitle = 'Dashboard'
  protected readonly navItems = NAV_ITEMS

  private readonly _url = toSignal(
    this._router.events.pipe(
      filter((event): event is NavigationEnd => event instanceof NavigationEnd),
      map(event => event.urlAfterRedirects)
    ),
    { initialValue: this._router.url }
  )
  protected readonly bare = computed(() => BARE_ROUTES.some(route => this._url().startsWith(route)))
}
