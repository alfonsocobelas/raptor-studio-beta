import { timingSafeEqual } from 'crypto'
import { CanActivate, ExecutionContext, Injectable, UnauthorizedException } from '@nestjs/common'
import { ConfigService } from '@nestjs/config'

/**
 * El raspador (Alloy, o cualquier Prometheus) no puede iniciar sesión, así que /metrics no
 * puede protegerse con el guard de sesión — y en una app generada sin auth no hay ningún
 * guard global. Este token bearer es el mecanismo primario, no un refuerzo.
 *
 * La comparación es en tiempo constante: un `===` corta en el primer byte distinto y filtra
 * por el tiempo de respuesta cuánto prefijo acertó el atacante.
 */
@Injectable()
export class MetricsTokenGuard implements CanActivate {
  constructor(private readonly configService: ConfigService) {}

  canActivate(context: ExecutionContext): boolean {
    const expected = this.configService.get<string>('metrics.token')
    if (!expected) {
      // Sin token configurado no hay acceso legítimo posible: cerrado.
      throw new UnauthorizedException()
    }

    const header = context.switchToHttp().getRequest<{ headers: Record<string, string | undefined> }>()
      .headers['authorization']
    if (!header?.startsWith('Bearer ')) {
      throw new UnauthorizedException()
    }

    const provided = Buffer.from(header.slice('Bearer '.length))
    const secret = Buffer.from(expected)
    // timingSafeEqual exige buffers del mismo tamaño; la longitud no es secreta
    if (provided.length !== secret.length || !timingSafeEqual(provided, secret)) {
      throw new UnauthorizedException()
    }

    return true
  }
}
