import { Module } from '@nestjs/common'
import { ConfigService } from '@nestjs/config'
import { APP_GUARD } from '@nestjs/core'
import { AcceptInvitationHandler } from './application/handlers/accept-invitation.handler'
import { ForgotPasswordHandler } from './application/handlers/forgot-password.handler'
import { InviteUserHandler } from './application/handlers/invite-user.handler'
import { LoginHandler } from './application/handlers/login.handler'
import { LogoutHandler } from './application/handlers/logout.handler'
import { ChangePasswordHandler } from './application/handlers/change-password.handler'
import { ResetPasswordHandler } from './application/handlers/reset-password.handler'
import { AcceptInvitationUseCase } from './application/use-cases/accept-invitation-usecase.service'
import { InviteUserUseCase } from './application/use-cases/invite-user-usecase.service'
import { LoginUseCase } from './application/use-cases/login-usecase.service'
import { LogoutUseCase } from './application/use-cases/logout-usecase.service'
import { RequestPasswordResetUseCase } from './application/use-cases/request-password-reset-usecase.service'
import { ChangePasswordUseCase } from './application/use-cases/change-password-usecase.service'
import { ResetPasswordUseCase } from './application/use-cases/reset-password-usecase.service'
import { ResolveSessionUseCase } from './application/use-cases/resolve-session-usecase.service'
import { SearchUsersUseCase } from './application/use-cases/search-users-usecase.service'
import { ChangeUserRoleUseCase } from './application/use-cases/change-user-role-usecase.service'
import { DisableUserUseCase } from './application/use-cases/disable-user-usecase.service'
import { ReactivateUserUseCase } from './application/use-cases/reactivate-user-usecase.service'
import { SearchUsersHandler } from './application/handlers/search-users.handler'
import { ChangeUserRoleHandler } from './application/handlers/change-user-role.handler'
import { DisableUserHandler } from './application/handlers/disable-user.handler'
import { ReactivateUserHandler } from './application/handlers/reactivate-user.handler'
import { UsersController } from './infrastructure/entrypoints/users.controller'
import { AuthConfig } from './application/ports/auth-config'
import { Clock } from './application/ports/clock'
import { EmailSender } from './application/ports/email-sender'
import { PasswordHasher } from './application/ports/password-hasher'
import { SecureTokenGenerator } from './application/ports/secure-token-generator'
import { AuthTokenRepository } from './domain/auth-token-repository'
import { SessionRepository } from './domain/session-repository'
import { UserRepository } from './domain/user-repository'
import { Argon2PasswordHasher } from './infrastructure/adapters/argon2-password-hasher'
import { ConfigAuthConfig } from './infrastructure/adapters/config-auth-config'
import { CryptoSecureTokenGenerator } from './infrastructure/adapters/crypto-secure-token-generator'
import { createEmailSender } from './infrastructure/adapters/email-sender.factory'
import { SystemClock } from './infrastructure/adapters/system-clock'
import { AuthController } from './infrastructure/entrypoints/auth.controller'
import { RolesGuard } from './infrastructure/guards/roles.guard'
import { SessionGuard } from './infrastructure/guards/session.guard'
import { TypeOrmAuthTokenRepository } from './infrastructure/persistence/typeorm/typeorm-auth-token.repository'
import { TypeOrmSessionRepository } from './infrastructure/persistence/typeorm/typeorm-session.repository'
import { TypeOrmUserRepository } from './infrastructure/persistence/typeorm/typeorm-user.repository'
import { AppLogger } from '../../../shared/domain/logger/logger'
import { SmtpConfig } from '../../../shared/infrastructure/config/config-types'

@Module({
  controllers: [AuthController, UsersController],
  providers: [
    LoginUseCase,
    LogoutUseCase,
    ResolveSessionUseCase,
    InviteUserUseCase,
    AcceptInvitationUseCase,
    RequestPasswordResetUseCase,
    ResetPasswordUseCase,
    ChangePasswordUseCase,
    SearchUsersUseCase,
    ChangeUserRoleUseCase,
    DisableUserUseCase,
    ReactivateUserUseCase,
    LoginHandler,
    LogoutHandler,
    InviteUserHandler,
    AcceptInvitationHandler,
    ForgotPasswordHandler,
    ResetPasswordHandler,
    ChangePasswordHandler,
    SearchUsersHandler,
    ChangeUserRoleHandler,
    DisableUserHandler,
    ReactivateUserHandler,
    SessionGuard,
    RolesGuard,
    // Global default-deny: SessionGuard runs first (populates request.user), then
    // RolesGuard reads it. Routes opt out with @Public(); @Roles() tightens further.
    // Registered here (not the composition root) so the guards travel with AuthModule: any
    // consumer of the module — production via RootModule, or a narrower test harness — gets the
    // same default-deny wiring without having to re-declare it.
    { provide: APP_GUARD, useExisting: SessionGuard },
    { provide: APP_GUARD, useExisting: RolesGuard },
    { provide: UserRepository, useClass: TypeOrmUserRepository },
    { provide: SessionRepository, useClass: TypeOrmSessionRepository },
    { provide: AuthTokenRepository, useClass: TypeOrmAuthTokenRepository },
    { provide: PasswordHasher, useClass: Argon2PasswordHasher },
    { provide: SecureTokenGenerator, useClass: CryptoSecureTokenGenerator },
    { provide: Clock, useClass: SystemClock },
    { provide: AuthConfig, useClass: ConfigAuthConfig },
    {
      provide: EmailSender,
      inject: [ConfigService, AppLogger],
      useFactory: (config: ConfigService, logger: AppLogger): EmailSender =>
        createEmailSender(config.get<SmtpConfig>('smtp'), logger)
    }
  ]
})
export class AuthModule {}
