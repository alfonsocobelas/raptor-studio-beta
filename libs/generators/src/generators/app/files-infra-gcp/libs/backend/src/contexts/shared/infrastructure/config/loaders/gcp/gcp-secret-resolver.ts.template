import { SecretManagerServiceClient } from '@google-cloud/secret-manager'
import { SecretResolutionError } from '../../../../domain/errors'

const VAULT_PREFIX = 'vault.'

/**
 * Minimal contract needed to read secrets. The real SecretManagerServiceClient
 * returns a longer tuple, so the factory below adapts it to this shape and tests
 * can inject a fake without the GCP SDK.
 */
export interface SecretsReader {
  getProjectId(): Promise<string>
  accessSecretVersion(request: { name: string }): Promise<[{ payload?: { data?: Uint8Array | string | null } | null }]>
}

/** True when any (possibly nested) value is a `vault.*` placeholder. */
export function containsVaultReferences(value: unknown): boolean {
  if (typeof value === 'string') {
    return value.startsWith(VAULT_PREFIX)
  }

  if (Array.isArray(value)) {
    return value.some(containsVaultReferences)
  }

  if (value !== null && typeof value === 'object') {
    return Object.values(value).some(containsVaultReferences)
  }

  return false
}

/**
 * Deep-clones `config`, replacing every `vault.*` string with its Secret Manager
 * secret value. Non-vault values are returned untouched.
 */
export async function resolveSecrets<T>(config: T, client: SecretsReader): Promise<T> {
  if (typeof config === 'string' && config.startsWith(VAULT_PREFIX)) {
    return (await getSecretValue(config, client)) as unknown as T
  }

  if (Array.isArray(config)) {
    return (await Promise.all(config.map(item => resolveSecrets(item, client)))) as unknown as T
  }

  if (config !== null && typeof config === 'object') {
    const resolved: Record<string, unknown> = {}

    for (const [key, value] of Object.entries(config)) {
      resolved[key] = await resolveSecrets(value, client)
    }

    return resolved as T
  }

  return config
}

/**
 * Builds the real Secret Manager client. Project and credentials resolve from
 * Application Default Credentials (12-factor); no explicit configuration here.
 */
export function createSecretManagerReader(): SecretsReader {
  const client = new SecretManagerServiceClient()
  return {
    getProjectId: () => client.getProjectId(),
    accessSecretVersion: async request => {
      const [response] = await client.accessSecretVersion(request)
      return [response ?? {}]
    }
  }
}

/**
 * Secret ids flatten `vault.*` dots into dashes (vault.typeorm.password →
 * typeorm-password) and are namespaced as `${GCP_SECRETS_PREFIX}-<name>`: exactly
 * the ids secret-manager.tf creates. The prefix is injected by the IaC (see iac/),
 * mirroring AWS_SECRETS_PREFIX.
 */
async function getSecretValue(reference: string, client: SecretsReader): Promise<string | undefined> {
  const flatName = reference.slice(VAULT_PREFIX.length).replace(/\./g, '-')
  const prefix = process.env['GCP_SECRETS_PREFIX']
  const secretId = prefix ? `${prefix}-${flatName}` : flatName

  try {
    const projectId = await client.getProjectId()
    const [response] = await client.accessSecretVersion({
      name: `projects/${projectId}/secrets/${secretId}/versions/latest`
    })
    const data = response.payload?.data
    if (data == null) {
      return undefined
    }
    return typeof data === 'string' ? data : Buffer.from(data).toString('utf-8')
  } catch (error) {
    // El code de gRPC no es un status HTTP: se deja el default (500) del error base
    throw new SecretResolutionError(`Failed to fetch secret [${secretId}] from GCP Secret Manager`, undefined, error)
  }
}
