import { RootValidator, validate } from '../../config-validation'
import { loadRawConfig } from '../config-sources'
import { containsVaultReferences, createSecretsManagerClient, resolveSecrets } from './aws-secret-resolver'

/**
 * AWS-backed loader: bundled JSON with every `vault.*` placeholder resolved
 * against AWS Secrets Manager. When the config has no placeholders (local/test)
 * it skips AWS entirely, so no credentials are needed there.
 */
export default async (): Promise<RootValidator> => {
  const config = loadRawConfig()

  const resolved = containsVaultReferences(config) ? await resolveSecrets(config, createSecretsManagerClient()) : config

  return validate(resolved)
}
