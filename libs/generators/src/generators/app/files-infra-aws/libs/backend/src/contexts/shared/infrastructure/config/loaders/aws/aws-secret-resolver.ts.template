import { GetSecretValueCommand, SecretsManagerClient } from '@aws-sdk/client-secrets-manager'
import { SecretResolutionError } from '../../../../domain/errors'

const VAULT_PREFIX = 'vault.'

/**
 * Minimal contract needed to read secrets. `SecretsManagerClient` satisfies it
 * structurally, so tests can inject a fake without the AWS SDK.
 */
export interface SecretsReader {
  send(command: GetSecretValueCommand): Promise<{ SecretString?: string }>
}

/** True when any (possibly nested) value is a `vault.*` placeholder. */
export function containsVaultReferences(value: unknown): boolean {
  if (typeof value === 'string') {
    return value.startsWith(VAULT_PREFIX)
  }

  if (Array.isArray(value)) {
    return value.some(containsVaultReferences)
  }

  if (value !== null && typeof value === 'object') {
    return Object.values(value).some(containsVaultReferences)
  }

  return false
}

/**
 * Deep-clones `config`, replacing every `vault.*` string with its Secrets Manager
 * secret value. Non-vault values are returned untouched.
 */
export async function resolveSecrets<T>(config: T, client: SecretsReader): Promise<T> {
  if (typeof config === 'string' && config.startsWith(VAULT_PREFIX)) {
    return (await getSecretValue(config, client)) as unknown as T
  }

  if (Array.isArray(config)) {
    return (await Promise.all(config.map(item => resolveSecrets(item, client)))) as unknown as T
  }

  if (config !== null && typeof config === 'object') {
    const resolved: Record<string, unknown> = {}

    for (const [key, value] of Object.entries(config)) {
      resolved[key] = await resolveSecrets(value, client)
    }

    return resolved as T
  }

  return config
}

/**
 * Builds the real Secrets Manager client. Region and credentials resolve from the
 * standard AWS environment (12-factor); no explicit configuration here.
 */
export function createSecretsManagerClient(): SecretsManagerClient {
  return new SecretsManagerClient({})
}

/**
 * Secret names flatten `vault.*` dots into dashes (vault.typeorm.password →
 * typeorm-password) and are namespaced as `${AWS_SECRETS_PREFIX}/<name>`: Secrets
 * Manager shares one namespace per account+region, unlike one-vault-per-env Azure.
 * The prefix is injected by the IaC (see iac/aws), mirroring AZURE_KEYVAULT_URL.
 */
async function getSecretValue(reference: string, client: SecretsReader): Promise<string | undefined> {
  const flatName = reference.slice(VAULT_PREFIX.length).replace(/\./g, '-')
  const prefix = process.env['AWS_SECRETS_PREFIX']
  const secretName = prefix ? `${prefix}/${flatName}` : flatName

  try {
    const secret = await client.send(new GetSecretValueCommand({ SecretId: secretName }))
    return secret.SecretString
  } catch (error) {
    const status = (error as { $metadata?: { httpStatusCode?: number } })?.$metadata?.httpStatusCode
    throw new SecretResolutionError(`Failed to fetch secret [${secretName}] from AWS Secrets Manager`, status, error)
  }
}
