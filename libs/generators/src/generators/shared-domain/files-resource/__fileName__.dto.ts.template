<%_ if (enums.length) { _%>
import { <%- enums.map(e => e.name).join(', ') %> } from './<%- fileName %>-enums'

<%_ } _%>
<%_ unions.forEach(u => { _%>
export type <%- u.name %> = <%- u.values %>

<%_ }) _%>
export interface <%- className %>Dto {
<%_ dtoLines.forEach(line => { _%>
  <%- line %>
<%_ }) _%>
}
