{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copia este fichero a settings.local.json (ignorado por git) y personalízalo. Estos hooks son personales, no del equipo.",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "_comment_macos": "Descomenta la línea de macOS si estás en Mac",
            "command": "osascript -e 'display notification \"Claude necesita tu atención\" with title \"SAP Licenses\"' 2>/dev/null || notify-send 'SAP Licenses' 'Claude necesita tu atención' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Tarea completada\" with title \"SAP Licenses\" sound name \"Glass\"' 2>/dev/null || notify-send 'SAP Licenses' 'Tarea completada' 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
