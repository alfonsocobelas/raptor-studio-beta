{
  "env": "qa",
  "app": {
    "port": 3000,
    "baseUrl": "vault.APP-BASE-URL"
  },
  "cors": {
    "origin": "vault.CORS-ORIGIN"
  },
  "logger": {
    "level": "info"
  },
  "typeorm": {
    "type": "postgres",
    "host": "vault.DB-HOST",
    "port": 5432,
    "username": "vault.DB-USER",
    "password": "vault.DB-PASSWORD",
    "database": "vault.DB-NAME",
    "ssl": true,
    "autoLoadEntities": true,
    "synchronize": false,
    "dropSchema": false,
    "logging": false,
    "migrationsRun": true,
    "migrationsTransactionMode": "all"
  }
}
