  "flows": [
    {
      "name": "De la máquina averiada a la factura",
      "description": "El recorrido completo de una orden: entra la máquina, se presupuesta, el cliente decide, se repara (con parada por recambio si falta pieza), se entrega con el parte firmado y administración factura.",
      "nodes": [
        {
          "id": "entra-maquina",
          "kind": "start",
          "text": "Entra la máquina averiada en el taller"
        },
        {
          "id": "abrir-orden",
          "kind": "step",
          "text": "Se abre la orden con la avería que cuenta el cliente",
          "entity": "orden",
          "status": "recibida"
        },
        {
          "id": "presupuestar",
          "kind": "step",
          "text": "El jefe de taller presupuesta la reparación",
          "entity": "orden",
          "status": "presupuestada",
          "transition": "presupuestar"
        },
        {
          "id": "aprueba-cliente",
          "kind": "decision",
          "text": "¿Aprueba el cliente el presupuesto?"
        },
        {
          "id": "aprobar",
          "kind": "step",
          "text": "Se aprueba y la máquina entra en reparación",
          "entity": "orden",
          "status": "en_reparacion",
          "transition": "aprobar"
        },
        {
          "id": "rechazar",
          "kind": "step",
          "text": "Se rechaza y se devuelve la máquina sin tocar",
          "entity": "orden",
          "status": "rechazada",
          "transition": "rechazar"
        },
        {
          "id": "fin-rechazada",
          "kind": "end",
          "text": "Máquina devuelta sin reparar"
        },
        {
          "id": "reparar",
          "kind": "step",
          "text": "El mecánico repara y apunta horas y recambios",
          "entity": "orden"
        },
        {
          "id": "falta-recambio",
          "kind": "decision",
          "text": "¿Falta algún recambio?"
        },
        {
          "id": "pedir-recambio",
          "kind": "step",
          "text": "La orden queda esperando el pedido al proveedor",
          "entity": "orden",
          "status": "esperando_recambio",
          "transition": "pedir-recambio"
        },
        {
          "id": "llega-recambio",
          "kind": "step",
          "text": "Llega el recambio y se reanuda la reparación",
          "entity": "orden",
          "status": "en_reparacion",
          "transition": "reanudar"
        },
        {
          "id": "terminar",
          "kind": "step",
          "text": "Se termina la reparación y se avisa al cliente",
          "entity": "orden",
          "status": "reparada",
          "transition": "terminar"
        },
        {
          "id": "entregar",
          "kind": "step",
          "text": "Se entrega la máquina con el parte de trabajo firmado",
          "entity": "orden",
          "status": "entregada",
          "transition": "entregar"
        },
        {
          "id": "facturar",
          "kind": "step",
          "text": "Administración factura la orden a fin de mes",
          "entity": "orden",
          "status": "facturada",
          "transition": "facturar"
        },
        {
          "id": "fin-cerrada",
          "kind": "end",
          "text": "Orden cerrada"
        }
      ],
