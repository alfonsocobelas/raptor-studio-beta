  "brief": {
    "business": "Correduría de seguros de hogar que tramita siniestros propios. Entra el parte del asegurado, se asigna un perito, se valoran los daños y se avisa al asegurado; si la indemnización procede se aprueba con su importe y se paga, y si no, se rechaza anotando el motivo. El recorrido acaba en pagado o en rechazado.",
    "rules": [
      "Un siniestro solo se perita después de asignarle perito.",
      "El importe aprobado no puede superar el estimado en más de un 10 %.",
      "Un siniestro rechazado no vuelve a moverse.",
      "El motivo de un rechazo queda siempre en las observaciones."
    ],
    "glossary": [
      {
        "term": "Parte",
        "means": "La comunicación del asegurado que abre el siniestro"
      },
      {
        "term": "Peritación",
        "means": "La visita y valoración de los daños por el perito"
      },
      {
        "term": "Indemnización",
        "means": "El importe aprobado que se paga al asegurado"
      }
    ]
  },
