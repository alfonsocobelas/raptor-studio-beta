  "flows": [
    {
      "name": "De la recepción del bote al informe facturado",
      "description": "El recorrido de una muestra desde que entra el bote en recepción hasta que administración la factura.",
      "nodes": [
        {
          "id": "llega-bote",
          "kind": "start",
          "text": "Llega el bote del punto de muestreo"
        },
        {
          "id": "registrar",
          "kind": "step",
          "text": "Se registra la muestra en recepción",
          "entity": "muestra",
          "status": "recibida"
        },
        {
          "id": "analizar",
          "kind": "step",
          "text": "El técnico analiza la muestra",
          "entity": "muestra",
          "status": "en_analisis"
        },
        {
          "id": "dentro-limite",
          "kind": "decision",
          "text": "¿Todos los parámetros dentro del límite legal?"
        },
        {
          "id": "desviacion",
          "kind": "step",
          "text": "Se marca la desviación y se repite el análisis",
          "entity": "muestra",
          "status": "fuera_de_rango"
        },
        {
          "id": "validar",
          "kind": "step",
          "text": "El responsable valida los resultados",
          "entity": "muestra",
          "status": "validada"
        },
        {
          "id": "informar",
          "kind": "step",
          "text": "Se emite el informe al cliente",
          "entity": "muestra",
          "status": "informada"
        },
        {
          "id": "facturar",
          "kind": "step",
          "text": "Administración factura la muestra",
          "entity": "muestra",
          "status": "facturada"
        },
        {
          "id": "cerrada",
          "kind": "end",
          "text": "Muestra cerrada"
        }
      ],
