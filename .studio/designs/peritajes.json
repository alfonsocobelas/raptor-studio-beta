  "brief": {
    "business": "Gabinete de peritación de seguros de hogar que trabaja por encargo de tres compañías. La compañía abre un siniestro, el gabinete lo asigna a un perito que cubra su provincia, el perito visita, redacta un informe con fotografías y presupuestos, y la compañía lo acepta o lo devuelve con reparos. El recorrido acaba en cerrado o en rechazado. El cuello de botella es el cuadro de peritos, y el material probatorio (fotos y PDF) es parte del entregable, no un adorno.",
    "rules": [
      "No se puede asignar un perito que no cubra la provincia del siniestro.",
      "No se puede dar por peritado un siniestro sin informe con fotografías.",
      "La valoración nunca puede superar el capital de la póliza.",
      "Un siniestro rechazado no vuelve a moverse.",
      "Un informe devuelto con reparos vuelve a manos del perito.",
      "Al asignar un siniestro, el perito recibe un correo con la referencia y la dirección de la visita.",
      "Cuando la compañía acepta el informe, se avisa por correo al asegurado."
    ],
    "glossary": [
      {
        "term": "Encargo",
        "means": "El siniestro que abre la compañía y que el gabinete debe peritar"
      },
      {
        "term": "Reparos",
        "means": "Devolución del informe por la compañía para que el perito lo corrija"
      },
      {
        "term": "Franquicia",
        "means": "Parte del daño que asume el asegurado y se descuenta de la indemnización"
      },
      {
        "term": "Colegiado",
        "means": "Número que acredita al perito ante las compañías"
      }
    ]
  },
